<!DOCTYPE html>
<html lang="{{ ui_lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <meta name="i18n-catalog" content="{{ i18n_catalog }}">
  <title>{{ t("settings.page_title") }}</title>
  <meta name="description" content="{{ t("settings.page_description") }}">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/static/style.css">
  <style>
    /* This page's own layout. Every shared control and role comes from
       style.css; a rule here that another page also needs belongs there. */
    body { font-size: calc(14px * var(--type-scale)); line-height: 1.6; min-height: 100vh; }
    a { color: inherit; }
    button, input, select, textarea { font: inherit; color: inherit; }
    .page { max-width: 1240px; margin: 0 auto; padding: var(--s-12) var(--s-4) var(--s-20); }
    .settings { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: var(--s-12); align-items: start; }
    .settings-nav { position: sticky; top: calc(var(--bar-h) + var(--s-6)); display: grid; border-left: 1px solid var(--border); }
    .settings-nav a { display: flex; align-items: center; justify-content: space-between; min-height: 44px; padding: var(--s-2) var(--s-4); margin-left: -1px; text-decoration: none; border-left: 2px solid transparent; transition: color var(--t-fast), border-color var(--t-fast); }
    .settings-nav a:hover { color: var(--text); }
    .settings-nav a[aria-current="page"] { color: var(--accent); border-left-color: var(--accent); }
    .dirty-dot { width: 6px; height: 6px; background: var(--accent); border-radius: 50%; visibility: hidden; }
    .settings-nav a.dirty .dirty-dot { visibility: visible; }
    .nav-dots { display: flex; gap: var(--s-1); }
    .missing-dot { width: 6px; height: 6px; background: var(--warn); border-radius: 50%; visibility: hidden; }
    .settings-nav a.missing .missing-dot { visibility: visible; }
    .tab-head { display: grid; gap: var(--s-2); margin-bottom: var(--s-8); max-width: var(--measure); }
    .form { display: grid; gap: var(--s-6); max-width: var(--measure); }
    .field-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--s-4); }
    .input.narrow { width: 96px; }
    .key-missing { color: var(--warn); }
    .actions-line { display: flex; align-items: center; gap: var(--s-4); flex-wrap: wrap; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); flex-wrap: wrap; margin-bottom: var(--s-4); }
    .table-wrap { overflow-x: auto; container-type: inline-size; border: 1px solid var(--border); background: var(--bg-elev); }
    table.src { width: 100%; border-collapse: collapse; min-width: 640px; }
    table.src th { text-align: left; padding: var(--s-2) var(--s-5); background: var(--surface); border-bottom: 1px solid var(--border); }
    table.src td { padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--border); font-size: calc(14px * var(--type-scale)); vertical-align: middle; }
    table.src tr.src-row { cursor: pointer; transition: background-color var(--t-fast); }
    table.src tr.src-row:hover, table.src tr.src-row.open { background: var(--surface); }
    table.src .name { white-space: nowrap; font-weight: 600; font-size: calc(18px * var(--type-scale)); }
    table.src .feed-problem { display: block; margin-top: var(--s-1); font-weight: 400; white-space: normal; color: var(--warn); }
    table.src tr.editor > td { background: var(--surface); padding: var(--s-5); border-bottom: 1px solid var(--border-strong); }
    .editor-body { position: sticky; left: var(--s-5); width: calc(100cqi - 2 * var(--s-5)); }
    tr.editor[inert] .form { opacity: .4; }
    tr.editor .form { max-width: none; }
    .editor-title { margin-bottom: var(--s-4); }
    .editor-foot { display: flex; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap; margin-top: var(--s-5); }
    table.src .target { font-family: var(--font-mono); font-size: calc(14px * var(--type-scale)); color: var(--text-dim); word-break: break-all; }
    table.src.assign { min-width: 0; }
    table.src .name .areas-note { display: block; margin-top: var(--s-1); font-weight: 400; white-space: normal; }
    table.src td.areas-pos-cell { width: 1%; }
    .areas-pos { width: 96px; }
    .areas-cell { display: flex; align-items: center; gap: var(--s-3); }
    .areas-cell .select { flex: 0 1 320px; min-width: 0; }
    .areas-foot, .areas-foot .actions-line { align-items: flex-end; }
    .areas-merge .select { width: 200px; }
    .areas-part { margin-top: var(--s-12); }
    .tab-head + .areas-part { margin-top: 0; }
    .areas-part-head { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); flex-wrap: wrap; min-height: 44px; margin-bottom: var(--s-3); }
    .areas-save { margin-top: var(--s-4); }
    table.src.areas-table, table.src.assign { min-width: 0; }
    .areas-threshold { display: flex; flex-wrap: wrap; }
    @media (max-width: 720px) {
      .areas-part { margin-top: var(--s-8); }
      .page { padding-top: var(--s-8); }
      .settings { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
      .settings-nav { position: static; display: flex; overflow-x: auto; overflow-y: hidden; border-left: 0; border-bottom: 1px solid var(--border); }
      /* The bar clips the tab's last pixel, the one over its bottom border, so the tab is 1px taller to keep 44px of taps. */
      .settings-nav a { border-left: 0; margin-left: 0; border-bottom: 2px solid transparent; margin-bottom: -1px; min-height: calc(44px + 1px); white-space: nowrap; gap: var(--s-2); }
      .settings-nav a[aria-current="page"] { border-bottom-color: var(--accent); }
      .settings-nav::before { content: "›" / ""; order: 1; position: sticky; right: 0; pointer-events: none; flex: 0 0 var(--s-8); display: flex; align-items: center; justify-content: flex-end; padding-right: var(--s-2); background: linear-gradient(to right, transparent, var(--bg) var(--s-4)); font-family: var(--font-mono); font-size: calc(12px * var(--type-scale)); color: var(--text-dim); }
      .settings-nav::after { content: ""; order: 2; position: relative; flex: 0 0 var(--s-8); margin-left: calc(-1 * var(--s-8)); background: var(--bg); }
      table.src.assign thead { display: none; }
      table.src.assign, table.src.assign tbody, table.src.assign tr, table.src.assign td { display: block; }
      table.src.assign td.name { white-space: normal; border-bottom: 0; padding-bottom: var(--s-2); }
      table.src.assign td + td { padding-top: 0; }
      .areas-cell { flex-wrap: wrap; }
      .areas-cell .select { flex-basis: 100%; }
    }
  </style>
</head>
<body>
{% with current="settings" %}{% include "_site_bar.html.j2" %}{% endwith %}
  <main class="page">
    <div class="page-head">
      <span class="label">{{ t("site.settings") }}</span>
      <h1 class="display">{{ t("settings.heading", elements={"em": ("em", {})}) }}</h1>
    </div>

    <div class="settings">
      <nav class="settings-nav" aria-label="{{ t("settings.nav_label") }}">
        <a class="label" href="#model" data-tab="model">{{ t("settings.tab_model") }} <span class="nav-dots"><span class="missing-dot"></span><span class="dirty-dot"></span></span></a>
        <a class="label" href="#digest" data-tab="digest">{{ t("settings.tab_digest") }} <span class="nav-dots"><span class="missing-dot"></span><span class="dirty-dot"></span></span></a>
        <a class="label" href="#pipeline" data-tab="pipeline">{{ t("settings.tab_pipeline") }} <span class="nav-dots"><span class="missing-dot"></span><span class="dirty-dot"></span></span></a>
        <a class="label" href="#notifications" data-tab="notifications">{{ t("settings.tab_notifications") }} <span class="nav-dots"><span class="missing-dot"></span><span class="dirty-dot"></span></span></a>
        <a class="label" href="#sources" data-tab="sources">{{ t("settings.tab_sources") }} <span class="nav-dots"><span class="missing-dot"></span><span class="dirty-dot"></span></span></a>
        <a class="label" href="#areas" data-tab="areas">{{ t("settings.tab_areas") }} <span class="nav-dots"><span class="missing-dot"></span><span class="dirty-dot"></span></span></a>
        <a class="label" href="#tracking" data-tab="tracking">{{ t("settings.tab_tracking") }} <span class="nav-dots"><span class="missing-dot"></span><span class="dirty-dot"></span></span></a>
      </nav>

      <div>
        <form class="tab" data-tab="model" id="model-form" novalidate hidden>
          <div class="tab-head">
            <h2 class="heading">{{ t("settings.tab_model") }}</h2>
            <p class="small">{{ t("settings.model_intro") }}</p>
            <p class="small" data-loading>{{ t("settings.loading_settings") }}</p>
            <div class="notice err" id="model-missing" hidden></div>
          </div>
          <div class="form">
            <div class="field">
              <span class="label" id="provider-label">{{ t("settings_field.llm_provider.provider") }}</span>
              <div class="choices" id="providers" role="radiogroup" aria-labelledby="provider-label"></div>
            </div>
            <div class="field">
              <label class="label" for="model-input">{{ t("settings_field.llm_provider.model") }}</label>
              <input class="input" id="model-input" type="text" autocomplete="off">
              <p class="small" id="model-hint"></p>
            </div>
            <div class="field">
              <span class="label" id="embedding-provider-label">{{ t("settings_field.vote_similarity.provider") }}</span>
              <div class="choices" id="embedding-providers" role="radiogroup" aria-labelledby="embedding-provider-label"></div>
              <p class="small">{{ t("settings_help.vote_similarity.provider") }}</p>
            </div>
            <div class="field">
              <label class="label" for="embedding-model-input">{{ t("settings_field.vote_similarity.model") }}</label>
              <input class="input" id="embedding-model-input" type="text" autocomplete="off">
              <p class="small">{{ t("settings_help.vote_similarity.model") }}</p>
            </div>
            <div class="field">
              <label class="label" for="vote-enabled">{{ t("settings_field.vote_similarity.enabled") }}</label>
              <select class="select" id="vote-enabled"><option value="false">{{ t("settings_option.off") }}</option><option value="true">{{ t("settings_option.on") }}</option></select>
              <p class="small">{{ t("settings.vote_similarity_hint", elements={"code": ("code", {})}) }}</p>
            </div>
            <div class="field">
              <label class="label" for="vote-seeds">{{ t("settings_field.vote_similarity.max_seeds") }}</label>
              <input class="input narrow" id="vote-seeds" type="number" min="1" autocomplete="off">
              <p class="small">{{ t("settings_help.vote_similarity.max_seeds") }}</p>
            </div>
            <div class="actions-line">
              <button class="btn primary" type="submit" id="save-model" disabled>{{ t("settings.save") }}</button>
              <div class="notice" id="model-result" role="status" hidden></div>
            </div>
          </div>
        </form>

        <form class="tab" data-tab="digest" id="digest-form" novalidate hidden>
          <div class="tab-head">
            <h2 class="heading">{{ t("settings.tab_digest") }}</h2>
            <p class="small">{{ t("settings.digest_intro") }}</p>
            <p class="small" data-loading>{{ t("settings.loading_settings") }}</p>
            <div class="notice err" id="digest-missing" hidden></div>
          </div>
          <div class="form">
            <div class="field">
              <span class="label">{{ t("settings_field.general.digest_schedule") }}</span>
              <div class="field-row">
                <div class="field"><label class="small" for="morning">{{ t("settings_option.schedule_morning") }}</label><input class="input narrow" id="morning" type="number" min="0" max="23" autocomplete="off"></div>
                <div class="field"><label class="small" for="evening">{{ t("settings_option.schedule_evening") }}</label><input class="input narrow" id="evening" type="number" min="0" max="23" autocomplete="off"></div>
              </div>
              <div class="notice err" id="hours-error" data-field-error hidden></div>
              <p class="small">{{ t("settings.hours_hint") }}</p>
            </div>
            <div class="field">
              <label class="label" for="timezone">{{ t("settings_field.general.timezone") }}</label>
              <select class="select" id="timezone"></select>
              <p class="small">{{ t("settings_help.general.timezone") }}</p>
              <p class="small" id="timezone-detected" hidden>{{ t("settings.timezone_detected") }}</p>
            </div>
            <div class="field">
              <label class="label" for="output-language">{{ t("settings_field.digest.output_language") }}</label>
              <select class="select" id="output-language"></select>
              <p class="small">{{ t("settings_help.digest.output_language") }}</p>
            </div>
            <div class="field">
              <label class="label" for="style-prompt">{{ t("settings_field.digest.style_prompt") }}</label>
              <textarea class="input" id="style-prompt" rows="4"></textarea>
              <p class="small">{{ t("settings_help.digest.style_prompt") }}</p>
            </div>
            <div class="field">
              <label class="label" for="type-scale">{{ t("settings_field.digest.type_scale") }}</label>
              <select class="select" id="type-scale"><option value="0.875">{{ t("settings_option.type_scale_smaller") }}</option><option value="1">{{ t("settings_option.type_scale_default") }}</option><option value="1.125">{{ t("settings_option.type_scale_larger") }}</option></select>
              <p class="small">{{ t("settings_help.digest.type_scale") }}</p>
            </div>
            <div class="field">
              <label class="label" for="rank-by-preference">{{ t("settings_field.digest.rank_by_preference") }}</label>
              <select class="select" id="rank-by-preference"><option value="false">{{ t("settings_option.off") }}</option><option value="true">{{ t("settings_option.on") }}</option></select>
              <p class="small">{{ t("settings_help.digest.rank_by_preference") }}</p>
            </div>
            <div class="field">
              <label class="label" for="preference-source">{{ t("settings_field.digest.preference_source") }}</label>
              <select class="select" id="preference-source"><option value="cosine">{{ t("settings_option.preference_cosine") }}</option><option value="clef">Clef</option></select>
              <p class="small">{{ t("settings_help.digest.preference_source") }}</p>
              <p class="small" id="clef-needs-votes" hidden>{{ t("settings.clef_needs_votes") }}</p>
              <p class="small" id="clef-needs" hidden>{{ t("settings_help.clef_needs_token") }}</p>
            </div>
            <div class="field">
              <label class="label" for="summarize-follow">{{ t("settings_field.digest.summarize_follow") }}</label>
              <select class="select" id="summarize-follow"><option value="false">{{ t("settings_option.off") }}</option><option value="true">{{ t("settings_option.on") }}</option></select>
              <p class="small">{{ t("settings_help.digest.summarize_follow") }}</p>
            </div>
            <div class="field">
              <label class="label" for="vote-half-life">{{ t("settings_field.digest.vote_half_life_days") }}</label>
              <input class="input narrow" id="vote-half-life" type="number" min="1" max="365" autocomplete="off">
              <p class="small">{{ t("settings_help.digest.vote_half_life_days") }}</p>
            </div>
            <div class="field">
              <label class="label" for="topic-lifetime">{{ t("settings_field.digest.topic_lifetime_days") }}</label>
              <input class="input narrow" id="topic-lifetime" type="number" min="1" max="365" autocomplete="off">
              <p class="small">{{ t("settings_help.digest.topic_lifetime_days") }}</p>
            </div>
            <div class="actions-line">
              <button class="btn primary" type="submit" id="save-digest" disabled>{{ t("settings.save") }}</button>
              <div class="notice" id="digest-result" role="status" hidden></div>
            </div>
          </div>
        </form>

        <form class="tab" data-tab="pipeline" id="pipeline-form" novalidate hidden>
          <div class="tab-head">
            <h2 class="heading">{{ t("settings.tab_pipeline") }}</h2>
            <p class="small">{{ t("settings.pipeline_intro") }}</p>
            <p class="small" data-loading>{{ t("settings.loading_settings") }}</p>
            <div class="notice err" id="pipeline-missing" hidden></div>
          </div>
          <div class="form">
            <div class="field">
              <label class="label" for="window-hours">{{ t("settings_field.general.digest_window_hours") }}</label>
              <input class="input narrow" id="window-hours" type="number" min="1" max="168" autocomplete="off">
              <p class="small">{{ t("settings_help.general.digest_window_hours") }}</p>
            </div>
            <div class="field">
              <label class="label" for="max-articles">{{ t("settings_field.digest.max_articles_per_digest") }}</label>
              <input class="input narrow" id="max-articles" type="number" min="1" autocomplete="off">
              <p class="small">{{ t("settings_help.digest.max_articles_per_digest") }}</p>
            </div>
            <div class="field">
              <label class="label" for="featured-threshold">{{ t("settings_field.routing.score_threshold") }}</label>
              <input class="input narrow" id="featured-threshold" type="number" min="0" max="100" autocomplete="off">
              <p class="small">{{ t("settings_help.routing.score_threshold") }}</p>
            </div>
            <div class="field">
              <span class="label">{{ t("settings.characters_read") }}</span>
              <div class="field-row">
                <div class="field"><label class="small" for="scoring-snippet">{{ t("settings.snippet_scoring") }}</label><input class="input narrow" id="scoring-snippet" type="number" min="1" autocomplete="off"></div>
                <div class="field"><label class="small" for="summarize-snippet">{{ t("settings.snippet_summary") }}</label><input class="input narrow" id="summarize-snippet" type="number" min="1" autocomplete="off"></div>
                <div class="field"><label class="small" for="filter-snippet">{{ t("settings.snippet_filter") }}</label><input class="input narrow" id="filter-snippet" type="number" min="1" autocomplete="off"></div>
              </div>
              <p class="small">{{ t("settings_help.snippet_lengths") }}</p>
            </div>
            <div class="field">
              <label class="label" for="reasoning-effort">{{ t("settings_field.llm_provider.reasoning_effort") }}</label>
              <select class="select" id="reasoning-effort"><option value="default">{{ t("settings.effort_default") }}</option><option value="low">{{ t("settings.effort_low") }}</option><option value="medium">{{ t("settings.effort_medium") }}</option><option value="high">{{ t("settings.effort_high") }}</option></select>
              <p class="small">{{ t("settings.effort_hint") }}</p>
            </div>
            <div class="actions-line">
              <button class="btn primary" type="submit" id="save-pipeline" disabled>{{ t("settings.save") }}</button>
              <div class="notice" id="pipeline-result" role="status" hidden></div>
            </div>
          </div>
        </form>

        <form class="tab" data-tab="notifications" id="notify-form" action="/api/settings/notify" novalidate hidden>
          <div class="tab-head">
            <h2 class="heading">{{ t("settings.tab_notifications") }}</h2>
            <p class="small">{{ t("settings.notifications_intro") }}</p>
            <p class="small" data-loading>{{ t("settings.loading_settings") }}</p>
            <div class="notice err" id="notifications-missing" hidden></div>
          </div>
          <div class="form">
            <div class="field">
              <label class="label" for="discord-webhook">{{ t("settings_field.notify.discord_webhook_url") }}</label>
              <input class="input" id="discord-webhook" type="text" placeholder="https://discord.com/api/webhooks/..." autocomplete="off">
              <p class="small">{{ t("settings.webhook_hint") }}</p>
              <p class="small" id="notify-state" hidden>{{ t("settings.notify_off_state") }}</p>
            </div>
            <div class="field">
              <label class="label" for="email-to">{{ t("settings_field.notify.email_to") }}</label>
              <input class="input" id="email-to" type="email" placeholder="you@example.com" autocomplete="off">
              <p class="small">{{ t("settings_help.notify.email_to") }}</p>
            </div>
            <div class="field">
              <label class="label" for="email-from">{{ t("settings_field.notify.email_from") }}</label>
              <input class="input" id="email-from" type="email" placeholder="digest@your-domain" autocomplete="off">
              <p class="small">{{ t("settings_help.notify.email_from") }}</p>
            </div>
            <div class="actions-line">
              <button class="btn primary" type="submit" id="save-notify" disabled>{{ t("settings.save") }}</button>
              <button class="btn danger" type="button" id="notify-off" hidden>{{ t("settings.turn_off") }}</button>
              <div class="notice" id="notify-result" role="status" hidden></div>
            </div>
          </div>
        </form>

        <div class="tab" data-tab="sources" hidden>
          <div class="tab-head">
            <h2 class="heading">{{ t("settings.tab_sources") }}</h2>
            <p class="small">{{ t("settings.sources_intro") }}</p>
          </div>
          <div class="toolbar">
            <div class="seg" role="group" aria-label="{{ t("settings.filter_label") }}">
              <button type="button" data-filter="all" aria-pressed="true">{{ t("settings.filter_all") }}</button>
              <button type="button" data-filter="rss" aria-pressed="false">{{ t("source_type.rss") }}</button>
              <button type="button" data-filter="newsletter" aria-pressed="false">{{ t("source_type.newsletter") }}</button>
            </div>
            <div class="actions-line">
              <div class="notice" id="sources-notice" role="status" hidden></div>
              <button class="btn primary" type="button" id="add-source" disabled>{{ t("settings.add_source") }}</button>
            </div>
          </div>
          <div class="table-wrap">
            <table class="src">
              <thead><tr><th class="label">{{ t("settings.col_name") }}</th><th class="label">{{ t("settings.col_type") }}</th><th class="label">{{ t("settings.col_lane") }}</th><th class="label">{{ t("settings.col_target") }}</th><th class="label">{{ t("settings.col_tags") }}</th></tr></thead>
              <tbody id="src-body"><tr data-loading><td colspan="5" class="small">{{ t("settings.loading_sources") }}</td></tr></tbody>
            </table>
          </div>
        </div>

        <div class="tab" data-tab="areas" hidden>
          <div class="tab-head">
            <h2 class="heading">{{ t("settings.tab_areas") }}</h2>
            <p class="small">{{ t("settings.areas_intro") }}</p>
          </div>
          <section class="areas-part" aria-labelledby="areas-active-h">
            <div class="areas-part-head"><h3 class="label" id="areas-active-h">{{ t("settings.tab_areas") }}</h3></div>
            <div class="table-wrap">
              <table class="src areas-table">
                <thead><tr><th class="label">{{ t("settings.col_name") }}</th><th class="label">{{ t("settings.col_position") }}</th></tr></thead>
                <tbody id="area-body"><tr data-loading><td colspan="2" class="small">{{ t("settings.loading_areas") }}</td></tr></tbody>
              </table>
            </div>
            <div class="actions-line areas-save">
              <button class="btn primary" type="button" id="save-order" disabled>{{ t("settings.save_order") }}</button>
              <div class="notice" id="order-result" role="status" hidden></div>
            </div>
          </section>
          <section class="areas-part" aria-labelledby="areas-proposed-h">
            <div class="areas-part-head"><h3 class="label" id="areas-proposed-h">{{ t("settings.proposed") }}</h3></div>
            <div class="table-wrap">
              <table class="src areas-table">
                <thead><tr><th class="label">{{ t("settings.col_name") }}</th><th class="label">{{ t("settings.col_counts") }}</th></tr></thead>
                <tbody id="proposed-body"></tbody>
              </table>
            </div>
          </section>
          <section class="areas-part" aria-labelledby="areas-sources-h">
            <div class="areas-part-head">
              <h3 class="label" id="areas-sources-h">{{ t("settings.tab_sources") }}</h3>
              <div class="actions-line">
                <div class="notice" id="areas-notice" role="status" hidden></div>
                <button class="btn primary" type="button" id="propose-areas" disabled>{{ t("settings.propose_areas") }}</button>
              </div>
            </div>
            <div class="table-wrap">
              <table class="src assign">
                <thead><tr><th class="label">{{ t("settings.col_source") }}</th><th class="label">{{ t("settings.col_area") }}</th></tr></thead>
                <tbody id="assign-body"><tr data-loading><td colspan="2" class="small">{{ t("settings.loading_sources") }}</td></tr></tbody>
              </table>
            </div>
            <div class="actions-line areas-save">
              <button class="btn primary" type="button" id="save-assign" disabled>{{ t("settings.save_assignments") }}</button>
              <div class="notice" id="assign-result" role="status" hidden></div>
            </div>
          </section>
          <section class="areas-part" id="threshold-block" aria-labelledby="areas-threshold-h">
            <div class="areas-part-head"><h3 class="label" id="areas-threshold-h">{{ t("settings.birth_threshold") }}</h3></div>
            <div class="field-row areas-threshold">
              <div class="field"><label class="label" for="th-articles">{{ t("settings.threshold_articles") }}</label><input class="input narrow" id="th-articles" type="number" min="1" step="1" autocomplete="off" disabled></div>
              <div class="field"><label class="label" for="th-issues">{{ t("settings.threshold_issues") }}</label><input class="input narrow" id="th-issues" type="number" min="1" step="1" autocomplete="off" disabled></div>
            </div>
            <div class="actions-line areas-save">
              <button class="btn primary" type="button" id="save-threshold" disabled>{{ t("settings.save") }}</button>
              <div class="notice" id="threshold-result" role="status" hidden></div>
              <p class="small" id="threshold-hint" hidden>{{ t("settings.threshold_unset") }}</p>
            </div>
          </section>
          <details class="more areas-part"><summary>{{ t("settings.closed") }}</summary>
            <ul class="small" id="closed-list"></ul>
          </details>
        </div>

        <div class="tab" data-tab="tracking" hidden>
          <div class="tab-head">
            <h2 class="heading">{{ t("settings.tab_tracking") }}</h2>
            <p class="small">{{ t("settings.tracking_intro") }}</p>
          </div>
          <div class="toolbar">
            <div class="notice" id="topics-notice" role="status" hidden></div>
            <button class="btn primary" type="button" id="add-topic" disabled>{{ t("settings.add_topic") }}</button>
          </div>
          <div class="table-wrap">
            <table class="src">
              <thead><tr><th class="label">{{ t("settings.col_name") }}</th><th class="label">{{ t("settings.col_description") }}</th><th class="label">{{ t("settings.col_threshold") }}</th><th class="label">{{ t("settings.col_embedding_model") }}</th></tr></thead>
              <tbody id="topic-body"><tr data-loading><td colspan="4" class="small">{{ t("settings.loading_topics") }}</td></tr></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>

  <template id="editor-tpl">
    <tr class="editor"><td colspan="5"><div class="editor-body">
      <h3 class="label editor-title"></h3>
      <div class="form">
        <div class="field-row">
          <div class="field"><label class="label" for="e-name">{{ t("settings.col_name") }}</label><input class="input" id="e-name" name="name" type="text" autocomplete="off"></div>
          <div class="field"><span class="label">{{ t("settings.col_type") }}</span>
            <div class="seg" role="group" aria-label="{{ t("settings.col_type") }}"><button type="button" data-type="rss">{{ t("source_type.rss") }}</button><button type="button" data-type="newsletter">{{ t("source_type.newsletter") }}</button></div>
          </div>
          <div class="field"><label class="label" for="e-lane">{{ t("settings.col_lane") }}</label>
            <select class="select" id="e-lane" name="lane"><option value="skim">{{ t("lane.skim") }}</option><option value="read">{{ t("lane.read") }}</option><option value="follow">{{ t("lane.follow") }}</option></select>
          </div>
        </div>
        <div class="field" data-for="rss"><label class="label" for="e-url">{{ t("settings.feed_url") }}</label><input class="input" id="e-url" name="url" type="text" autocomplete="off"></div>
        <div class="field" data-for="newsletter"><label class="label" for="e-email">{{ t("settings.sender_match") }}</label><input class="input" id="e-email" name="email_match" type="text" placeholder="from:hi@example.com" autocomplete="off">
          <p class="small">{{ t("settings.sender_match_hint") }}</p></div>
        <div class="field" data-for="newsletter"><label class="label" for="e-home">{{ t("settings.homepage") }}</label><input class="input" id="e-home" name="homepage" type="text" autocomplete="off"></div>
        <div class="field"><label class="label" for="e-tags">{{ t("settings.col_tags") }}</label><input class="input" id="e-tags" name="tags" type="text" placeholder="{{ t("settings.tags_placeholder") }}" autocomplete="off"></div>
        <div class="field-row">
          <div class="field"><label class="label" for="e-area">{{ t("settings.col_area") }}</label>
            <select class="select" id="e-area" name="area_id"><option value="">{{ t("settings.area_none") }}</option></select>
            <span class="pill" data-suggested hidden>{{ t("settings.suggested") }}</span>
          </div>
          <div class="field"><button class="btn secondary" type="button" data-act="suggest">{{ t("settings.suggest") }}</button></div>
        </div>
        <p class="small" data-suggest-note hidden></p>
      </div>
      <div class="editor-foot">
        <div class="actions-line">
          <button class="btn primary" type="button" data-act="save" disabled>{{ t("settings.save_source") }}</button>
          <button class="btn secondary" type="button" data-act="cancel">{{ t("settings.cancel") }}</button>
          <div class="notice" role="status" hidden></div>
        </div>
        <div class="actions-line">
          <button class="btn danger" type="button" data-act="retire">{{ t("settings.retire") }}</button>
          <div class="notice" role="status" hidden></div>
        </div>
      </div>
    </div></td></tr>
  </template>

  <template id="area-editor-tpl">
    <tr class="editor"><td colspan="2"><div class="editor-body">
      <h3 class="label editor-title"></h3>
      <div class="form">
        <div class="field"><label class="label" for="a-name">{{ t("settings.col_name") }}</label><input class="input" id="a-name" name="name" type="text" autocomplete="off"></div>
      </div>
      <div class="editor-foot areas-foot">
        <div class="actions-line">
          <button class="btn primary" type="button" data-act="activate" data-proposed hidden>{{ t("settings.activate") }}</button>
          <button class="btn secondary" type="button" data-act="save" disabled>{{ t("settings.save_name") }}</button>
          <button class="btn secondary" type="button" data-act="cancel">{{ t("settings.cancel") }}</button>
          <div class="notice" role="status" hidden></div>
        </div>
        <div class="actions-line" data-proposed hidden>
          <button class="btn danger" type="button" data-act="dismiss">{{ t("settings.dismiss") }}</button>
          <div class="field areas-merge"><label class="label" for="a-into">{{ t("settings.merge_into") }}</label><select class="select" id="a-into" name="into"></select></div>
          <button class="btn danger" type="button" data-act="merge">{{ t("settings.merge") }}</button>
        </div>
      </div>
    </div></td></tr>
  </template>

  <template id="topic-editor-tpl">
    <tr class="editor"><td colspan="4"><div class="editor-body">
      <h3 class="label editor-title"></h3>
      <div class="form">
        <div class="field"><label class="label" for="t-name">{{ t("settings.col_name") }}</label><input class="input" id="t-name" name="name" type="text" autocomplete="off"></div>
        <div class="field"><label class="label" for="t-description">{{ t("settings.col_description") }}</label><textarea class="input" id="t-description" name="description" rows="3"></textarea>
          <p class="small">{{ t("settings.topic_description_hint") }}</p></div>
        <div class="field-row">
          <div class="field"><label class="label" for="t-threshold">{{ t("settings.col_threshold") }}</label><input class="input narrow" id="t-threshold" name="threshold" type="number" min="0" max="1" step="0.01" autocomplete="off"></div>
          <div class="field"><label class="label" for="t-model">{{ t("settings.col_embedding_model") }}</label><input class="input" id="t-model" name="model" type="text" autocomplete="off"></div>
        </div>
        <p class="small">{{ t("settings.topic_threshold_hint", elements={"code": ("code", {})}) }}</p>
      </div>
      <div class="editor-foot">
        <div class="actions-line">
          <button class="btn primary" type="button" data-act="save" disabled>{{ t("settings.save_topic") }}</button>
          <button class="btn secondary" type="button" data-act="cancel">{{ t("settings.cancel") }}</button>
          <div class="notice" role="status" hidden></div>
        </div>
        <div class="actions-line">
          <button class="btn danger" type="button" data-act="remove">{{ t("settings.remove") }}</button>
          <div class="notice" role="status" hidden></div>
        </div>
      </div>
    </div></td></tr>
  </template>

<script type="module" src="/static/settings.js"></script>
{% include "_probe_script.html.j2" %}
</body>
</html>
