<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <title>Cyris Labels</title>
  <meta name="description" content="Blind labels for a Cyris deployment: one sampled article at a time, without the pipeline's verdict.">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap">
  <link rel="stylesheet" href="/static/style.css">
  <style>
    /* This page's own layout: raw's triage card (ui-language.md §6 labels), with
       an excerpt under the title and Skip between Down and Up. */
    body { font-size: calc(14px * var(--type-scale)); line-height: 1.6; min-height: 100vh; }
    a { color: inherit; }
    button { font: inherit; color: inherit; }
    .page { max-width: 600px; margin: 0 auto; padding: var(--s-12) var(--s-4) var(--s-20); }
    .deck-wrap { display: grid; gap: var(--s-6); }
    .card {
      min-height: 320px; background: var(--surface); border: 1px solid var(--border-strong);
      padding: var(--s-6); display: grid; align-content: start; gap: var(--s-4);
      cursor: grab; touch-action: pan-y; user-select: none;
      transition: border-color var(--t-fast), transform var(--t-fast);
    }
    .card.dragging { cursor: grabbing; transition: border-color var(--t-fast); }
    .card:hover { border-color: var(--text-faint); }
    .card.lean-up { border-color: var(--accent); }
    .card.lean-down { border-color: var(--warn); }
    .card h2 { font-weight: 600; font-size: calc(26px * var(--type-scale)); line-height: 1.3; letter-spacing: -.015em; text-wrap: balance; }
    .card .small { overflow-wrap: anywhere; }
    .deck-actions { display: grid; grid-template-columns: 1fr auto 1fr; gap: var(--s-3); }
    .deck-actions .btn { justify-content: center; height: 56px; }
    @media (prefers-reduced-motion: reduce) {
      .card { transform: none !important; }
    }
  </style>
</head>
<body>
{% with current="labels" %}{% include "_site_bar.html.j2" %}{% endwith %}
  <main class="page">
    <div class="page-head">
      <span class="label" id="l-progress">Loading…</span>
      <h1 class="display">Label it <em>blind</em></h1>
      <p class="small">Each card is an article the filter judged, without its verdict. Up if you want articles like it, down if not.</p>
    </div>
    <div class="deck-wrap">
      <article class="card" id="l-card" tabindex="0" role="link" hidden><span class="label" id="l-source"></span><h2 id="l-title" lang=""></h2><p class="small" id="l-excerpt" lang=""></p></article>
      <div class="deck-actions" id="l-actions" hidden><button class="btn danger" type="button" data-label="down">Down</button><button class="btn secondary" type="button" data-label="skip">Skip</button><button class="btn primary" type="button" data-label="up">Up</button></div>
      <p class="notice err" id="l-error" role="alert" hidden></p>
      <p class="small" id="l-hint" hidden>Swipe left for down, right for up. Tap the card to open the article in a new tab.</p>
      <p class="small" id="l-empty" hidden></p>
    </div>
  </main>
<script src="/static/labels.js"></script>
{% include "_probe_script.html.j2" %}
</body>
</html>
