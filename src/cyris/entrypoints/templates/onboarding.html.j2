<!DOCTYPE html>
<html lang="{{ ui_lang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="dark">
  <meta name="i18n-catalog" content="{{ i18n_catalog }}">
  <title>{{ t("onboarding.page_title") }}</title>
  <meta name="description" content="{{ t("onboarding.page_description") }}">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="/static/style.css">
  <style>
    /* This page's own layout: one step at a time, over the step list that says
       where the reader is (ui-language.md §6 onboarding). Every control and
       role comes from style.css; a rule here that another page also needs
       belongs there. */
    body { font-size: calc(14px * var(--type-scale)); line-height: 1.6; min-height: 100vh; }
    a { color: inherit; }
    button, input, select, textarea { font: inherit; color: inherit; }
    .page { max-width: var(--measure); margin: 0 auto; padding: var(--s-12) var(--s-4) var(--s-20); }
    .steps { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4); margin: 0 0 var(--s-8); padding: 0; list-style: none; }
    .steps li { display: flex; align-items: center; gap: var(--s-2); }
    .steps li::before { content: ""; width: 6px; height: 6px; border: 1px solid var(--border-strong); border-radius: 50%; }
    .steps li.done::before { background: var(--text-dim); border-color: var(--text-dim); }
    .steps li[aria-current="step"] { color: var(--accent); }
    .steps li[aria-current="step"]::before { background: var(--accent); border-color: var(--accent); }
    .step { display: grid; gap: var(--s-6); }
    .step-head { display: grid; gap: var(--s-2); }
    .step-nav { display: flex; align-items: center; gap: var(--s-4); flex-wrap: wrap; margin-top: var(--s-8); }
    .vote-card { gap: var(--s-2); }
    .vote-card .title { font-weight: 600; font-size: calc(18px * var(--type-scale)); line-height: 1.3; text-decoration: none; overflow-wrap: anywhere; }
    .vote-card .title:hover { text-decoration: underline; }
    .vote-card .seg { justify-self: start; margin-top: var(--s-1); }
    .add-feed { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
    .add-feed .input { flex: 1 1 14em; width: auto; min-width: 0; }
    #o-own .sources-check { margin-top: var(--s-4); }
    /* The opening takes what the site bar and the page's gutters leave of the
       viewport, so it never scrolls, and the stage takes what the sentence and
       the buttons leave of that. The sentence holds its place while it is
       hidden, so the stage does not jump when it shows. */
    .fold-fields { display: grid; gap: var(--s-6); margin-top: var(--s-4); }
    .opening { display: flex; flex-direction: column; gap: var(--s-5); height: calc(100svh - var(--bar-h) - var(--s-12) - var(--s-20)); }
    .opening-stage { position: relative; flex: 1; min-height: 0; }
    .opening-stage canvas { display: block; width: 100%; height: 100%; }
    /* A line of no height at the vanishing point, which the script sets: the
       logo centres on it without a transform, which §4 keeps for motion. */
    .opening-vp { position: absolute; left: 0; right: 0; height: 0; display: flex; align-items: center; justify-content: center; }
    .opening-logo { padding: var(--s-2) var(--s-3); background: var(--bg); opacity: 0; }
    /* The site bar drops the name below 720px; the logo on the stage keeps it. */
    .opening-logo .brand-name { display: inline; }
    .opening-claim { text-wrap: balance; }
    .opening-claim[data-held] { visibility: hidden; }
    .opening-nav { display: flex; align-items: center; gap: var(--s-4); }
  </style>
</head>
<body>
{% with current="onboarding" %}{% include "_site_bar.html.j2" %}{% endwith %}
  <main class="page">
    {# The opening is not a step: no hash names it, so a reload on a step keeps
       that step. Its headlines are the server's sample pool
       (GET /api/onboarding/headlines), and the script runs its three beats. #}
    <section class="opening" id="o-opening" hidden>
      <div class="opening-stage" id="o-stage" aria-hidden="true">
        <canvas id="o-canvas"></canvas>
        <div class="opening-vp"><span class="brand opening-logo" id="o-logo"><span class="brand-mark"></span><span class="brand-name">CYRIS</span></span></div>
      </div>
      <p class="heading opening-claim" id="o-claim" data-held>{{ t("onboarding.opening_claim", elements={"em": ("em", {})}) }}</p>
      <div class="opening-nav">
        <button class="btn secondary" type="button" id="o-skip-intro">{{ t("onboarding.skip_intro") }}</button>
        <button class="btn primary" type="button" id="o-show" hidden>{{ t("onboarding.show_me_how") }}</button>
      </div>
    </section>

    <div class="page-head">
      <span class="label" id="o-progress">{{ t("onboarding.progress", step=1, steps=7) }}</span>
      <h1 class="display">{{ t("onboarding.title", elements={"em": ("em", {})}) }}</h1>
      <p class="small">{{ t("onboarding.intro") }}</p>
    </div>

    <ol class="steps" id="o-steps">
      <li class="label" data-step="language">{{ t("onboarding.step_language") }}</li>
      <li class="label" data-step="schedule">{{ t("onboarding.step_schedule") }}</li>
      <li class="label" data-step="sources">{{ t("onboarding.step_sources") }}</li>
      <li class="label" data-step="votes">{{ t("onboarding.step_votes") }}</li>
      <li class="label" data-step="notify">{{ t("onboarding.step_notify") }}</li>
      <li class="label" data-step="model">{{ t("onboarding.step_model") }}</li>
      <li class="label" data-step="first-issue">{{ t("onboarding.step_first_issue") }}</li>
    </ol>

    <section class="step" data-step="language" hidden>
      <div class="step-head">
        <h2 class="heading">{{ t("onboarding.language_heading") }}</h2>
        <p class="small">{{ t("onboarding.language_lede") }}</p>
        <p class="small" data-loading>{{ t("onboarding.loading_settings") }}</p>
      </div>
      <div class="field">
        <label class="label" for="o-output-language">{{ t("settings_field.digest.output_language") }}</label>
        <p class="small">{{ t("settings_help.digest.output_language") }}</p>
        <select class="select" id="o-output-language"></select>
      </div>
      <div class="field">
        <label class="label" for="o-timezone">{{ t("settings_field.general.timezone") }}</label>
        <p class="small">{{ t("settings_help.general.timezone") }}</p>
        <select class="select" id="o-timezone"></select>
        <p class="small" id="o-timezone-detected" hidden>{{ t("onboarding.timezone_detected") }}</p>
      </div>
    </section>

    <section class="step" data-step="schedule" hidden>
      <div class="step-head">
        <h2 class="heading">{{ t("onboarding.schedule_heading") }}</h2>
        <p class="small">{{ t("onboarding.schedule_lede") }}</p>
        <p class="small" data-loading>{{ t("onboarding.loading_settings") }}</p>
      </div>
      <div class="field">
        <label class="label" for="o-morning">{{ t("settings_option.schedule_morning") }}</label>
        <p class="small">{{ t("onboarding.hours_help") }}</p>
        <input class="input" id="o-morning" type="number" min="0" max="23" autocomplete="off">
      </div>
      <div class="field">
        <label class="label" for="o-evening">{{ t("settings_option.schedule_evening") }}</label>
        <input class="input" id="o-evening" type="number" min="0" max="23" autocomplete="off">
      </div>
    </section>

    {# The list is the server's (GET /api/onboarding/feeds), offered only while the
       sources table is empty, in two screens of this one step: its topics, then
       the chosen topics' feeds, one checklist per topic. The hash names the
       screen: #sources, then #sources/feeds. Each pick is posted to
       POST /api/sources as listed, less the list's own topics. #}
    <section class="step" data-step="sources" hidden>
      <div class="step-head">
        <h2 class="heading">{{ t("onboarding.sources_heading") }}</h2>
        <p class="small" data-screen="topics">{{ t("onboarding.sources_topics_lede") }}</p>
        <p class="small" data-screen="feeds" hidden>{{ t("onboarding.sources_feeds_lede") }}</p>
        <p class="small" id="o-feeds-loading">{{ t("onboarding.loading_feeds") }}</p>
      </div>
      <div class="field" data-screen="topics" id="o-topics-screen" hidden>
        <span class="label" id="o-topics-label">{{ t("onboarding.topics") }}</span>
        <p class="small" id="o-feeds-hint">{{ t("onboarding.topics_hint") }}</p>
        <div class="tiles" id="o-topics" role="group" aria-labelledby="o-topics-label"></div>
      </div>
      <div data-screen="feeds" id="o-feeds-screen" hidden>
        <div id="o-feeds"></div>
        {# A feed the list lacks, by its address or its site's home page: the
           server checks it (POST /api/onboarding/feed-check) and names it by its
           own title, and Next posts it with the picks, under Your feeds. #}
        <div class="field">
          <label class="label" for="o-own-url">{{ t("onboarding.own_feed") }}</label>
          <p class="small">{{ t("onboarding.own_feed_help") }}</p>
          <div class="add-feed">
            <input class="input" id="o-own-url" type="url" inputmode="url" placeholder="https://example.com/feed.xml" autocomplete="off">
            <button class="btn secondary" type="button" id="o-own-add">{{ t("onboarding.add") }}</button>
          </div>
          <div class="notice" id="o-own-result" role="status" hidden></div>
        </div>
        <div id="o-own"></div>
        {# Fixed above the buttons: how many feeds Next sends, and past SLOW_PICKS
           in onboarding.js, that the Votes step waits for each of them. #}
        <p class="small" id="o-picked" aria-live="polite"></p>
      </div>
      <p class="small" id="o-feeds-had" hidden>{{ t("onboarding.sources_had") }}</p>
    </section>

    {# The cards are the server's (POST /api/onboarding/cards), read through the
       run's own RSS fetch; Next sends only the marked ones to POST /api/onboarding/votes. #}
    <section class="step" data-step="votes" hidden>
      <div class="step-head">
        <h2 class="heading">{{ t("onboarding.votes_heading") }}</h2>
        <p class="small">{{ t("onboarding.votes_lede") }}</p>
        <p class="small" id="o-cards-loading" aria-busy="true" hidden>{{ t("onboarding.fetching_cards") }}</p>
      </div>
      <div class="notice err" id="o-cards-empty" hidden></div>
      <p class="small" id="o-cards-none" hidden></p>
      <div class="panel" id="o-cards" hidden></div>
    </section>

    <section class="step" data-step="notify" hidden>
      <div class="step-head">
        <h2 class="heading">{{ t("onboarding.notify_heading") }}</h2>
        <p class="small">{{ t("onboarding.notify_lede") }}</p>
        <p class="small" data-loading>{{ t("onboarding.loading_settings") }}</p>
      </div>
      <div class="field">
        <label class="label" for="o-discord-webhook">{{ t("settings_field.notify.discord_webhook_url") }}</label>
        <p class="small">{{ t("onboarding.discord_webhook_help") }}</p>
        <input class="input" id="o-discord-webhook" type="text" placeholder="https://discord.com/api/webhooks/..." autocomplete="off">
      </div>
      <div class="field">
        <label class="label" for="o-email-to">{{ t("settings_field.notify.email_to") }}</label>
        <p class="small">{{ t("settings_help.notify.email_to") }}</p>
        <input class="input" id="o-email-to" type="email" placeholder="you@example.com" autocomplete="off">
      </div>
      <div class="field">
        <label class="label" for="o-email-from">{{ t("settings_field.notify.email_from") }}</label>
        <p class="small">{{ t("settings_help.notify.email_from") }}</p>
        <input class="input" id="o-email-from" type="email" placeholder="digest@your-domain" autocomplete="off">
      </div>
    </section>

    {# The providers are the ones GET /api/settings answers, each saying whether this
       machine has its key; a key lives in .env, never here. Check asks
       POST /api/diagnostics/llm and stores nothing; Next saves through
       POST /api/settings, which checks again. The fold holds each tuned setting the
       store still lacks, opened on its starting value (settings_starting_values.json),
       and Next saves them through the routes /settings saves them with. A stored
       setting's field stays hidden, so the wizard never writes over it. #}
    <section class="step" data-step="model" hidden>
      <div class="step-head">
        <h2 class="heading">{{ t("onboarding.model_heading") }}</h2>
        <p class="small">{{ t("onboarding.model_lede") }}</p>
        <p class="small" data-loading>{{ t("onboarding.loading_settings") }}</p>
      </div>
      <div class="field">
        <span class="label" id="o-provider-label">{{ t("settings_field.llm_provider.provider") }}</span>
        <div class="choices" id="o-providers" role="radiogroup" aria-labelledby="o-provider-label"></div>
        <p class="small" id="o-no-key" hidden></p>
      </div>
      <div class="field">
        <label class="label" for="o-model">{{ t("settings_field.llm_provider.model") }}</label>
        <p class="small" id="o-model-hint"></p>
        <input class="input" id="o-model" type="text" autocomplete="off">
        <div><button class="btn secondary" type="button" id="o-check" hidden>{{ t("onboarding.check") }}</button></div>
        <div class="notice" id="o-check-result" role="status" hidden></div>
      </div>
      <details class="more" id="o-advanced" hidden>
        <summary>{{ t("onboarding.advanced") }}</summary>
        <div class="fold-fields">
          <div class="field" data-key="vote_similarity.provider">
            <span class="label" id="o-embedding-provider-label">{{ t("settings_field.vote_similarity.provider") }}</span>
            <p class="small">{{ t("settings_help.vote_similarity.provider") }}</p>
            <div class="choices" id="o-embedding-providers" role="radiogroup" aria-labelledby="o-embedding-provider-label"></div>
          </div>
          <div class="field" data-key="vote_similarity.model">
            <label class="label" for="o-embedding-model">{{ t("settings_field.vote_similarity.model") }}</label>
            <p class="small">{{ t("settings_help.vote_similarity.model") }}</p>
            <input class="input" id="o-embedding-model" type="text" autocomplete="off" data-kind="text">
          </div>
          <div class="field" data-key="vote_similarity.max_seeds">
            <label class="label" for="o-vote-seeds">{{ t("settings_field.vote_similarity.max_seeds") }}</label>
            <p class="small">{{ t("settings_help.vote_similarity.max_seeds") }}</p>
            <input class="input" id="o-vote-seeds" type="number" min="1" autocomplete="off" data-kind="number">
          </div>
          <div class="field" data-key="general.digest_window_hours">
            <label class="label" for="o-window-hours">{{ t("settings_field.general.digest_window_hours") }}</label>
            <p class="small">{{ t("settings_help.general.digest_window_hours") }}</p>
            <input class="input" id="o-window-hours" type="number" min="1" max="168" autocomplete="off" data-kind="number">
          </div>
          <div class="field" data-key="digest.max_articles_per_digest">
            <label class="label" for="o-max-articles">{{ t("settings_field.digest.max_articles_per_digest") }}</label>
            <p class="small">{{ t("settings_help.digest.max_articles_per_digest") }}</p>
            <input class="input" id="o-max-articles" type="number" min="1" autocomplete="off" data-kind="number">
          </div>
          <div class="field" data-key="routing.score_threshold">
            <label class="label" for="o-featured-threshold">{{ t("settings_field.routing.score_threshold") }}</label>
            <p class="small">{{ t("settings_help.routing.score_threshold") }}</p>
            <input class="input" id="o-featured-threshold" type="number" min="0" max="100" autocomplete="off" data-kind="number">
          </div>
          <div class="field" data-key="digest.scoring_snippet_length">
            <label class="label" for="o-scoring-snippet">{{ t("settings_field.digest.scoring_snippet_length") }}</label>
            <p class="small">{{ t("settings_help.snippet_lengths") }}</p>
            <input class="input" id="o-scoring-snippet" type="number" min="1" autocomplete="off" data-kind="number">
          </div>
          <div class="field" data-key="digest.summarize_snippet_length">
            <label class="label" for="o-summarize-snippet">{{ t("settings_field.digest.summarize_snippet_length") }}</label>
            <input class="input" id="o-summarize-snippet" type="number" min="1" autocomplete="off" data-kind="number">
          </div>
          <div class="field" data-key="digest.filter_snippet_length">
            <label class="label" for="o-filter-snippet">{{ t("settings_field.digest.filter_snippet_length") }}</label>
            <input class="input" id="o-filter-snippet" type="number" min="1" autocomplete="off" data-kind="number">
          </div>
          <div class="field" data-key="digest.style_prompt">
            <label class="label" for="o-style-prompt">{{ t("settings_field.digest.style_prompt") }}</label>
            <p class="small">{{ t("settings_help.digest.style_prompt") }}</p>
            <textarea class="input" id="o-style-prompt" rows="4" data-kind="prose"></textarea>
          </div>
          <div class="field" data-key="digest.type_scale">
            <label class="label" for="o-type-scale">{{ t("settings_field.digest.type_scale") }}</label>
            <p class="small">{{ t("settings_help.digest.type_scale") }}</p>
            <select class="select" id="o-type-scale" data-kind="number"><option value="0.875">{{ t("settings_option.type_scale_smaller") }}</option><option value="1">{{ t("settings_option.type_scale_default") }}</option><option value="1.125">{{ t("settings_option.type_scale_larger") }}</option></select>
          </div>
          <div class="field" data-key="digest.rank_by_preference">
            <label class="label" for="o-rank-by-preference">{{ t("settings_field.digest.rank_by_preference") }}</label>
            <p class="small">{{ t("settings_help.digest.rank_by_preference") }}</p>
            <select class="select" id="o-rank-by-preference" data-kind="bool"><option value="false">{{ t("settings_option.off") }}</option><option value="true">{{ t("settings_option.on") }}</option></select>
          </div>
          <div class="field" data-key="digest.preference_source">
            <label class="label" for="o-preference-source">{{ t("settings_field.digest.preference_source") }}</label>
            <p class="small">{{ t("settings_help.digest.preference_source") }}</p>
            <p class="small" id="o-clef-needs" hidden>{{ t("settings_help.clef_needs_token") }}</p>
            <select class="select" id="o-preference-source" data-kind="text"><option value="cosine">{{ t("settings_option.preference_cosine") }}</option><option value="clef">Clef</option></select>
          </div>
          <div class="field" data-key="digest.summarize_follow">
            <label class="label" for="o-summarize-follow">{{ t("settings_field.digest.summarize_follow") }}</label>
            <p class="small">{{ t("settings_help.digest.summarize_follow") }}</p>
            <select class="select" id="o-summarize-follow" data-kind="bool"><option value="false">{{ t("settings_option.off") }}</option><option value="true">{{ t("settings_option.on") }}</option></select>
          </div>
          <div class="field" data-key="digest.vote_half_life_days">
            <label class="label" for="o-vote-half-life">{{ t("settings_field.digest.vote_half_life_days") }}</label>
            <p class="small">{{ t("settings_help.digest.vote_half_life_days") }}</p>
            <input class="input" id="o-vote-half-life" type="number" min="1" max="365" autocomplete="off" data-kind="number">
          </div>
          <div class="field" data-key="digest.topic_lifetime_days">
            <label class="label" for="o-topic-lifetime">{{ t("settings_field.digest.topic_lifetime_days") }}</label>
            <p class="small">{{ t("settings_help.digest.topic_lifetime_days") }}</p>
            <input class="input" id="o-topic-lifetime" type="number" min="1" max="365" autocomplete="off" data-kind="number">
          </div>
        </div>
      </details>
    </section>

    {# The run is the app Worker's own POST /run?period=&date=, the route any manual
       run takes. GET /api/onboarding/first-issue picks the key a later tick today
       cannot replace, and reads the run's outcome back from digest_runs. #}
    <section class="step" data-step="first-issue" hidden>
      <div class="step-head">
        <h2 class="heading">{{ t("onboarding.first_issue_heading") }}</h2>
        <p class="small">{{ t("onboarding.first_issue_lede") }}</p>
        <p class="small" id="o-issue-loading" aria-busy="true">{{ t("onboarding.checking_first_issue") }}</p>
      </div>
      <p class="small" id="o-issue-plan" hidden></p>
      <p class="small" id="o-vote-similarity" hidden></p>
    </section>

    <div class="step-nav">
      <button class="btn secondary" type="button" id="o-back">{{ t("onboarding.back") }}</button>
      <button class="btn secondary" type="button" id="o-skip">{{ t("onboarding.skip") }}</button>
      <button class="btn primary" type="button" id="o-next">{{ t("onboarding.next") }}</button>
      {# The last step's own action: it starts the run, and once a run fails it tries again. #}
      <button class="btn primary" type="button" id="o-start" hidden>{{ t("onboarding.start") }}</button>
      {# The way out, on the last step alone, once there is no run to start or one
         has been started. The mark is what keeps /settings from sending a
         deployment whose sources table is still empty straight back here. #}
      <a class="btn primary" id="o-finish" href="/settings?from=onboarding" hidden>{{ t("onboarding.finish") }}</a>
      <div class="notice" id="o-result" role="status" hidden></div>
    </div>
  </main>
<script type="module" src="/static/onboarding.js"></script>
{% include "_probe_script.html.j2" %}
</body>
</html>
