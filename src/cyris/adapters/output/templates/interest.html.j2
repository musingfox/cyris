<!DOCTYPE html>
<html lang="{{ ui_lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <title>CYRIS // {{ t("interest.map") }}</title>
    <meta name="description" content="{{ t("interest.description") }}">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        {% include "_tokens.css.j2" %}

        {% include "_components.css.j2" %}

        {% with container_width="960px", container_relative=false, line_height="1.6", font_features=false %}{% include "_page.css.j2" %}{% endwith %}

        {% include "_footer.css.j2" %}
    </style>
</head>
<body>
    {% include "_site_bar.html.j2" %}
    <div class="container">
        <div class="page-head">
            <span class="label">{{ t("interest.label") }}</span>
            <h1 class="display">{{ t("interest.heading", elements={"em": ("em", {})}) }}</h1>
            <p class="small">{{ t("interest.intro") }}</p>
        </div>

        {% if graph.nodes %}
        <svg class="graph-map" viewBox="0 0 {{ width }} {{ height }}" role="img" aria-label="{{ t("interest.map") }}">
            {% for edge in graph.edges %}{% set a = positions[edge.a] %}{% set b = positions[edge.b] %}<line class="graph-edge" x1="{{ a[0] }}" y1="{{ a[1] }}" x2="{{ b[0] }}" y2="{{ b[1] }}"></line>{% endfor %}
            {% for node in graph.nodes %}{% set p = positions[node.tag] %}<circle class="graph-node {{ node.polarity }}" data-polarity="{{ node.polarity }}" style="--b: {{ node.brightness }}" cx="{{ p[0] }}" cy="{{ p[1] }}" r="14"></circle>{% endfor %}
            {% for node in graph.nodes %}{% set p = positions[node.tag] %}<text class="graph-label" lang="" x="{{ p[0] }}" y="{{ p[1] + 30 }}" text-anchor="middle">{{ node.tag }}</text>{% endfor %}
        </svg>
        {% if lit %}
        <p class="small">{{ t("interest.legend") }}</p>
        {% elif holds_active %}
        <p class="small">{{ t("interest.holds_elsewhere") }}</p>
        {% else %}
        <p class="small">{{ t("interest.no_holds") }}</p>
        {% endif %}
        <div class="panel">
            <div class="panel-head"><span class="label">{{ t("interest.tags") }}</span></div>
            <table>
                <thead><tr><th>{{ t("interest.col_tag") }}</th><th>{{ t("interest.col_up") }}</th><th>{{ t("interest.col_down") }}</th><th>{{ t("interest.col_polarity") }}</th><th>{{ t("interest.col_days_left") }}</th></tr></thead>
                <tbody>
                {% for node in graph.nodes %}
                <tr><td lang="">{{ node.tag }}</td><td>{{ node.up }}</td><td>{{ node.down }}</td><td>{{ t("polarity." ~ node.polarity) }}</td><td>{{ "%.1f" | format(node.brightness * clock_days) }}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <p class="data">{{ t("interest.as_of", time=generated_at) }}</p>
        {% else %}
        <p class="small">{{ t("interest.empty", elements={"code": ("code", {"class": "data"})}) }}</p>
        {% endif %}

        <div class="footer">// <a href="{{ project_url }}">cyris</a></div>
    </div>
    {% include "_probe_script.html.j2" %}
</body>
</html>
