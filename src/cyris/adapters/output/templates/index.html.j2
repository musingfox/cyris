<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CYRIS // Archive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        {% include "_tokens.css.j2" %}

        {% include "_components.css.j2" %}

        {% with container_width="960px", container_relative=false, glow=none, line_height="1.6", font_features=false %}{% include "_page.css.j2" %}{% endwith %}

        .archive-row {
            display: grid;
            grid-template-columns: 170px 110px 1fr auto;
            align-items: center;
            gap: var(--s-4);
            padding: var(--s-3) var(--s-5);
            border-bottom: 1px solid var(--border);
            transition: background-color var(--t-fast);
        }

        .archive-row:last-child { border-bottom: 0; }
        .archive-row:hover { background: var(--surface); }

        .archive-row .date, .front-card .date { font-family: var(--font-mono); font-size: calc(22px * var(--type-scale)); font-weight: 500; font-variant-numeric: tabular-nums; }
        .archive-row .actions, .front-card .actions { display: flex; gap: var(--s-2); }
        .archive-row .actions { grid-column: 4; }

        .latest { color: var(--accent); }

        .front-card {
            background: var(--surface);
            border: 1px solid var(--border-strong);
            padding: var(--s-6);
            display: grid;
            gap: var(--s-4);
            margin-bottom: var(--s-5);
        }

        .front-card .line { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: baseline; }
        .front-card h2 { font-weight: 600; font-size: calc(22px * var(--type-scale)); line-height: 1.3; text-wrap: balance; }

        .empty-message {
            text-align: center;
            padding: 80px 20px;
            color: var(--text-dim);
            border: 1px dashed var(--border-strong);
            font-family: var(--font-mono);
            font-size: calc(16px * var(--type-scale));
            letter-spacing: 0.04em;
        }

        .empty-message code {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 2px 8px;
            color: var(--accent);
        }

        {% with layout="block", justify=false, align_center=false, margin_top="56px",
                  padding_top="24px", gap=none  %}{% include "_footer.css.j2" %}{% endwith %}

        @media (max-width: 720px) {
            .archive-row { grid-template-columns: 1fr auto; row-gap: var(--s-2); }
            .archive-row .small, .archive-row .actions { grid-column: 1 / -1; }
        }
    </style>
</head>
<body>
    {% macro actions(issue) %}<span class="actions"><a class="btn secondary sm" href="{{ issue.filename }}">Digest</a>{% if issue.raw_filename %}<a class="btn secondary sm" href="{{ issue.raw_filename }}">All articles</a>{% endif %}</span>{% endmacro %}
    {% include "_site_bar.html.j2" %}
    <div class="container">
        <div class="page-head">
            <span class="label">Archive</span>
            <h1 class="display">Every <em>issue</em></h1>
            <p class="small">Newest first. Each issue has the digest and the full list of articles it judged.</p>
        </div>

        {% if digests %}
        <article class="front-card">
            <div class="line"><span class="label latest">Latest</span><span class="date">{{ latest.date }}</span><span class="label">{{ latest.period }}</span></div>
            {% if card.lead %}<h2>{{ card.lead }}</h2>{% endif %}
            {% if "count" in card %}<span class="data">{{ card["count"] }} article{{ "" if card["count"] == 1 else "s" }}</span>{% endif %}
            {{ actions(latest) }}
        </article>
        {% for panel in months %}
        <section class="panel">
            <div class="panel-head"><span class="data">{{ panel.month }}</span><span class="label">{{ panel.issues | length }} issue{{ "" if panel.issues | length == 1 else "s" }}</span></div>
            {% for digest in panel.issues %}
            <div class="archive-row">
                <span class="date">{{ digest.date }}</span>
                <span class="label">{{ digest.period }}</span>
                {{ actions(digest) }}
            </div>
            {% endfor %}
        </section>
        {% endfor %}
        {% else %}
        <div class="empty-message">
            No digests yet. Run <code>cyris run</code> to generate your first digest.
        </div>
        {% endif %}

        <div class="footer">// cyris &middot; {{ digests | length }} issue{{ "" if digests | length == 1 else "s" }}</div>
    </div>
    {% include "_probe_script.html.j2" %}
</body>
</html>
