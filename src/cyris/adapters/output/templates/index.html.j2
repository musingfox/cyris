<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CYRIS // Archive</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        {% include "_tokens.css.j2" %}

        {% include "_components.css.j2" %}

        {% with container_width="960px", container_relative=false, glow="80% 50%", line_height="1.6", font_features=false %}{% include "_page.css.j2" %}{% endwith %}

        {% with masthead_padding="28px 0 24px", masthead_margin="56px", masthead_rule=true,
                  subtitle_margin="18px",
                  display_h1=true  %}{% include "_masthead.css.j2" %}{% endwith %}

        .digest-list {
            list-style: none;
            border: 1px solid var(--border);
            background: var(--bg-elev);
        }

        .digest-item {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 24px;
            padding: 20px 28px;
            border-bottom: 1px solid var(--border);
            transition: background-color var(--t-fast);
        }

        .digest-item:last-child { border-bottom: none; }

        .digest-item:hover { background: var(--surface); }

        .digest-date {
            font-family: var(--font-mono);
            font-size: calc(22px * var(--type-scale));
            font-weight: 500;
            color: var(--text);
            letter-spacing: -0.01em;
        }

        .digest-period {
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            text-transform: uppercase;
            letter-spacing: 0.14em;
            color: var(--text-faint);
            justify-self: start;
        }

        .digest-item .actions { display: flex; gap: var(--s-2); }

        .empty-message {
            text-align: center;
            padding: 80px 20px;
            color: var(--text-dim);
            border: 1px dashed var(--border-strong);
            font-family: var(--font-mono);
            font-size: calc(16px * var(--type-scale));
            letter-spacing: 0.04em;
        }

        .empty-message code {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 2px 8px;
            color: var(--accent);
        }

        {% with layout="block", justify=false, align_center=false, margin_top="56px",
                  padding_top="24px", gap=none, link_transition=false  %}{% include "_footer.css.j2" %}{% endwith %}

        @media (max-width: 720px) {
            .digest-item {
                grid-template-columns: 1fr auto;
                gap: 8px 16px;
                padding: 16px 18px;
            }
            .digest-item .actions { grid-column: 1 / -1; }
        }
    </style>
</head>
<body>
    {% include "_site_bar.html.j2" %}
    <div class="container">
        <header class="masthead">
            <h1>Digest <em>Archive</em></h1>
            <div class="subtitle">All past issues · sorted newest first</div>
        </header>

        {% if digests %}
        <ul class="digest-list">
            {% for digest in digests %}
            <li class="digest-item">
                <span class="digest-date">{{ digest.date }}</span>
                <span class="digest-period">{{ digest.period }}</span>
                <span class="actions"><a class="btn secondary sm" href="{{ digest.filename }}">Digest</a>{% if digest.raw_filename %}<a class="btn secondary sm" href="{{ digest.raw_filename }}">All articles</a>{% endif %}</span>
            </li>
            {% endfor %}
        </ul>
        {% else %}
        <div class="empty-message">
            No digests yet. Run <code>cyris run</code> or <code>cyris digest</code> to generate your first digest.
        </div>
        {% endif %}

        <div class="footer">// CYRIS &middot; local-first information agent</div>
    </div>
    {% include "_probe_script.html.j2" %}
</body>
</html>
