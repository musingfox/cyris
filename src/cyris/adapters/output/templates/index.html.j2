<!DOCTYPE html>
<html lang="{{ ui_lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <title>CYRIS // {{ t("site.archive") }}</title>
    <meta name="description" content="{{ t("index.description") }}">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@300;400;500;600&display=swap">
    <style>
        {% include "_tokens.css.j2" %}

        {% include "_components.css.j2" %}

        {% with container_width="960px", container_relative=false, line_height="1.6", font_features=false %}{% include "_page.css.j2" %}{% endwith %}

        .archive-row { grid-template-columns: 170px 110px 1fr auto; }

        .archive-row .date, .front-card .date { font-family: var(--font-mono); font-size: calc(19px * var(--type-scale)); font-weight: 500; font-variant-numeric: tabular-nums; }
        .archive-row .actions, .front-card .actions { display: flex; gap: var(--s-2); }
        .archive-row .actions { grid-column: 4; }
        .archive-row.same-day .date { color: var(--text-dim); }
        .archive-row, .front-card { position: relative; }
        .btn.sm.digest-link { position: static; }
        .btn.sm.digest-link::after { inset: 0; }

        .latest { color: var(--accent); }

        .front-card {
            background: var(--surface);
            border: 1px solid var(--border-strong);
            padding: var(--s-6);
            display: grid;
            gap: var(--s-4);
            margin-bottom: var(--s-5);
        }

        .front-card .line { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: baseline; }
        .front-card h2 { font-weight: 600; font-size: calc(19px * var(--type-scale)); line-height: 1.3; text-wrap: balance; }

        {% include "_footer.css.j2" %}

        @media (max-width: 720px) {
            .archive-row { grid-template-columns: 1fr auto; row-gap: var(--s-2); }
            .archive-row .small, .archive-row .actions { grid-column: 1 / -1; }
        }
    </style>
</head>
<body>
    {% macro actions(issue) %}<span class="actions"><a class="btn secondary sm digest-link" href="{{ issue.filename }}">{{ t("issue.digest") }}</a>{% if issue.raw_filename %}<a class="btn secondary sm" href="{{ issue.raw_filename }}">{{ t("issue.all_articles") }}</a>{% endif %}</span>{% endmacro %}
    {% include "_site_bar.html.j2" %}
    <div class="container">
        <div class="page-head">
            <span class="label">{{ t("site.archive") }}</span>
            <h1 class="display">{{ t("index.heading", elements={"em": ("em", {})}) }}</h1>
            <p class="small">{{ t("index.intro") }}</p>
            <p class="small gated" hidden>{{ t("index.interest", elements={"link": ("a", {"href": interest_path | default("/interest")})}) }}</p>
        </div>

        {% if digests %}
        <article class="front-card">
            <div class="line"><span class="label latest">{{ t("index.latest") }}</span><span class="date">{{ issue_day(latest.date, latest.started_at) }}</span>{% if latest.started_at %}<span class="label">{{ issue_hour(latest.started_at) }}</span>{% endif %}</div>
            {% if card.lead is not none %}<h2 lang="{{ card.lead_lang }}">{{ card.lead }}</h2>{% endif %}
            {% if card.count is not none %}<span class="data">{{ t("index.articles", count=card.count) }}</span>{% endif %}
            {% if card.topics is not none %}<p class="small" lang="{{ card.topics_lang }}">{{ card.topics }}</p>{% endif %}
            {{ actions(latest) }}
        </article>
        {% for panel in months %}
        <section class="panel">
            <div class="panel-head"><span class="data">{{ panel.month }}</span><span class="label">{{ t("index.issues", count=panel.issues | length) }}</span></div>
            {% for digest in panel.issues %}
            <div class="list-row archive-row{{ ' same-day' if digest.same_day }}">
                <span class="date">{{ issue_day(digest.date, digest.started_at) }}</span>
                <span class="label">{{ issue_hour(digest.started_at) }}</span>
                {% if digest["count"] is not none %}<span class="small">{{ t("index.articles", count=digest["count"]) }}</span>{% endif %}
                {{ actions(digest) }}
            </div>
            {% endfor %}
        </section>
        {% endfor %}
        {% else %}
        <p class="small">{{ t("index.empty", elements={"code": ("code", {"class": "data"})}) }}</p>
        {% endif %}

        <div class="footer">// <a href="{{ project_url }}">cyris</a> &middot; {{ t("index.issues", count=digests | length) }}</div>
    </div>
    {% include "_probe_script.html.j2" %}
</body>
</html>
