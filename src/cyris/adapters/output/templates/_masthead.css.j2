        .masthead {
            padding: {{ masthead_padding }};
            margin-bottom: {{ masthead_margin }};
            border-bottom: 1px solid var(--border);
{%- if masthead_rule %}
            position: relative;
{%- endif %}
        }
{% if masthead_rule %}
        .masthead::after {
            content: "";
            position: absolute;
            left: 0; right: 0; bottom: -1px;
            height: 1px;
            background: linear-gradient(90deg, transparent, var(--accent) 50%, transparent);
            opacity: 0.45;
        }
{% endif %}
        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
{%- if brand_margin %}
            margin-bottom: {{ brand_margin }};
{%- endif %}
        }

        .brand-mark {
            width: {{ mark_size }};
            height: {{ mark_size }};
            background: var(--accent);
            box-shadow: 0 0 0 4px rgba(198, 255, 61, 0.12){% if mark_glow %}, 0 0 24px rgba(198, 255, 61, 0.5){% endif %};
{%- if mark_pulse %}
            animation: pulse 2.4s ease-in-out infinite;
{%- endif %}
        }

        .brand-name {
            font-family: 'Geist Mono', monospace;
            font-size: calc(14px * var(--type-scale));
{%- if brand_weight %}
            font-weight: {{ brand_weight }};
{%- endif %}
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-dim);
        }

        .brand-name strong { color: var(--text); font-weight: 600; }

        .subtitle {
            margin-top: {{ subtitle_margin }};
            font-family: 'Geist Mono', monospace;
            font-size: calc(14px * var(--type-scale));
            letter-spacing: 0.14em;
            color: var(--text-faint);
            text-transform: uppercase;
        }
{% if display_h1 %}
        {# digest's headline is <h1 class="issue-title">, so a bare h1 rule would
           really match it. Only a page that asks for h1 typography gets one. #}
        h1 {
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: calc(clamp(52px, 8vw, 96px) * var(--type-scale));
            line-height: 1;
            letter-spacing: -0.03em;
        }

        h1 em { font-style: italic; color: var(--accent); }
{% endif %}
