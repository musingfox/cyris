        .masthead {
            padding: {{ masthead_padding }};
            margin-bottom: {{ masthead_margin }};
            border-bottom: 1px solid var(--border);
        }
        .subtitle {
            margin-top: {{ subtitle_margin }};
            font-family: var(--font-mono);
            font-size: calc(12px * var(--type-scale));
            letter-spacing: 0.14em;
            color: var(--text-dim);
            text-transform: uppercase;
        }
{% if display_h1 %}
        {# digest's headline is <h1 class="issue-title">, so a bare h1 rule would
           really match it. Only a page that asks for h1 typography gets one. #}
        h1 {
            font-family: var(--font-serif);
            font-weight: 400;
            font-size: calc(clamp(46px, 7vw, 84px) * var(--type-scale));
            line-height: 1;
            letter-spacing: -0.03em;
        }

        h1 em { font-style: italic; color: var(--accent); }
{% endif %}
