<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CYRIS // {{ date }} · {{ period }} · Raw</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        :root {
            --bg: #07070a;
            --bg-elev: #0d0d12;
            --surface: #11111a;
            --border: #1f1f2e;
            --text: #ebebf2;
            --text-dim: #8a8aa0;
            --text-faint: #56566e;
            --accent: #c6ff3d;
            --grid: rgba(198, 255, 61, 0.035);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Geist', system-ui, sans-serif;
            background: var(--bg);
            background-image:
                linear-gradient(var(--grid) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid) 1px, transparent 1px);
            background-size: 32px 32px, 32px 32px;
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
            padding: 24px 16px 80px;
        }

        .container { max-width: 900px; margin: 0 auto; }

        .masthead {
            padding: 24px 0 20px;
            margin-bottom: 40px;
            border-bottom: 1px solid var(--border);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 24px;
            font-family: 'Geist Mono', monospace;
            font-size: 13px;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: var(--text-dim);
        }

        .brand strong { color: var(--text); font-weight: 600; }

        .brand-mark {
            width: 12px;
            height: 12px;
            background: var(--accent);
            box-shadow: 0 0 0 4px rgba(198, 255, 61, 0.12);
        }

        h1 {
            font-family: 'Instrument Serif', serif;
            font-weight: 400;
            font-size: clamp(40px, 7vw, 72px);
            line-height: 1;
            letter-spacing: -0.03em;
        }

        h1 em { font-style: italic; color: var(--accent); }

        .subtitle {
            margin-top: 14px;
            font-family: 'Geist Mono', monospace;
            font-size: 12px;
            letter-spacing: 0.14em;
            color: var(--text-faint);
            text-transform: uppercase;
        }

        .source-group {
            border: 1px solid var(--border);
            background: var(--bg-elev);
            margin-bottom: 20px;
        }

        .source-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
        }

        .source-name {
            font-weight: 600;
            font-size: 15px;
            letter-spacing: -0.01em;
        }

        .source-count {
            font-family: 'Geist Mono', monospace;
            font-size: 11px;
            letter-spacing: 0.12em;
            color: var(--text-faint);
            text-transform: uppercase;
        }

        .promote-btn {
            border: 1px solid var(--border);
            padding: 1px 7px;
            background: var(--surface);
            color: var(--text-dim);
            font-family: 'Geist Mono', monospace;
            font-size: 11px;
            cursor: pointer;
        }

        .promote-btn:hover { color: var(--text); }
        .promote-btn.done { color: var(--accent); border-color: var(--accent); }
        .promote-btn.error { color: #e06c75; border-color: #e06c75; }
        .vote-group { display: none; gap: 4px; }

        .article {
            display: grid;
            grid-template-columns: 74px 46px 1fr auto;
            align-items: baseline;
            gap: 14px;
            padding: 11px 20px;
            border-bottom: 1px solid var(--border);
        }

        .article:last-child { border-bottom: none; }
        .article:hover { background: var(--surface); }

        .state {
            font-family: 'Geist Mono', monospace;
            font-size: 10px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-faint);
        }

        .state.accepted { color: var(--accent); }
        .state.rejected { color: #6b4a4a; }

        .score {
            font-family: 'Geist Mono', monospace;
            font-size: 12px;
            color: var(--text-dim);
            text-align: right;
        }

        .article a {
            color: var(--text);
            text-decoration: none;
            border-bottom: 1px solid transparent;
        }

        .article a:hover {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        .footer {
            margin-top: 48px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
            font-family: 'Geist Mono', monospace;
            font-size: 11px;
            letter-spacing: 0.08em;
            color: var(--text-faint);
            text-transform: uppercase;
        }

        .footer a { color: var(--text-dim); text-decoration: none; }
        .footer a:hover { color: var(--accent); }

        @media (max-width: 640px) {
            .article {
                grid-template-columns: 74px 1fr auto;
                gap: 4px 14px;
                padding: 12px 16px;
            }
            .score { grid-column: 2; text-align: left; }
            .article a { grid-column: 1 / span 3; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="masthead">
            <div class="brand">
                <div class="brand-mark"></div>
                <div><strong>CYRIS</strong> // Raw Feed</div>
            </div>
            <h1>Everything <em>collected</em></h1>
            <div class="subtitle">{{ date }} · {{ period | upper }} · {{ total }} articles · {{ groups | length }} sources</div>
        </header>

        {% for group in groups %}
        <section class="source-group">
            <div class="source-head">
                <span class="source-name">{{ group.name }}</span>
                <span class="source-count">{{ group.articles | length }}</span>
            </div>
            {% for a in group.articles %}
            <div class="article">
                <span class="state {{ a.state }}">{{ a.state }}</span>
                <span class="score">{{ "%.2f" | format(a.score) if a.score is not none else "—" }}</span>
                <a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a>
                <span class="vote-group" data-urls='{{ [a.url] | tojson }}'><button class="promote-btn" data-vote="up" title="想看">↑</button><button class="promote-btn" data-vote="down" title="不想看">↓</button></span>
            </div>
            {% endfor %}
        </section>
        {% endfor %}

        <div class="footer">
            <a href="{{ date }}-{{ period }}.html">← Back to digest</a>
            <a href="index.html">Archive →</a>
        </div>
    </div>
    {% include "_promote_script.html.j2" %}
</body>
</html>
