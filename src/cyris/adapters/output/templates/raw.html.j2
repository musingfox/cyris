<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CYRIS // {{ date }} · {{ period }} · Raw</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        {% include "_tokens.css.j2" %}

        {% include "_components.css.j2" %}

        {% with container_width="960px", container_relative=false, glow=none, line_height="1.6", font_features=false %}{% include "_page.css.j2" %}{% endwith %}

        .page-head { display: grid; gap: var(--s-4); margin-bottom: var(--s-12); }
        .page-head .seg { justify-self: start; }
        [hidden] { display: none !important; }

        .source-name { font-weight: 600; font-size: calc(20px * var(--type-scale)); }

        {% include "_promote.css.j2" %}

        .raw-row {
            display: grid;
            grid-template-columns: 96px 56px 1fr auto;
            align-items: baseline;
            gap: var(--s-4);
            padding: var(--s-3) var(--s-5);
            border-bottom: 1px solid var(--border);
            transition: background-color var(--t-fast);
        }

        .raw-row:last-child { border-bottom: 0; }
        .raw-row:hover { background: var(--surface); }

        .score {
            font-family: var(--font-mono);
            font-size: calc(16px * var(--type-scale));
            color: var(--text-dim);
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        .raw-row a {
            text-decoration: none;
            border-bottom: 1px solid transparent;
            transition: color var(--t-fast), border-color var(--t-fast);
        }

        .raw-row a:hover {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        .deck-wrap { max-width: 600px; margin: 0 auto; display: grid; gap: var(--s-6); }
        .card {
            min-height: 320px; background: var(--surface); border: 1px solid var(--border-strong);
            padding: var(--s-6); display: grid; align-content: start; gap: var(--s-4);
            cursor: grab; touch-action: pan-y; user-select: none;
            transition: border-color var(--t-fast), transform var(--t-fast);
        }
        .card.dragging { cursor: grabbing; transition: border-color var(--t-fast); }
        .card:hover { border-color: var(--text-faint); }
        .card.lean-up { border-color: var(--accent); }
        .card.lean-down { border-color: var(--warn); }
        .card h2 { font-weight: 600; font-size: calc(30px * var(--type-scale)); line-height: 1.3; letter-spacing: -.015em; text-wrap: balance; }
        .deck-actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); }
        .deck-actions .btn { justify-content: center; height: 56px; }

        {% with layout="block", justify=false, align_center=false, margin_top="48px",
                  padding_top="20px", gap=none  %}{% include "_footer.css.j2" %}{% endwith %}

        @media (max-width: 720px) {
            .raw-row { grid-template-columns: 96px 1fr auto; row-gap: var(--s-1); }
            .score { text-align: left; }
            .raw-row a { grid-column: 1 / -1; }
        }
    </style>
</head>
<body>
    {% include "_site_bar.html.j2" %}
    {% with view="raw" %}{% include "_issue_bar.html.j2" %}{% endwith %}
    <div class="container">
        <div class="page-head">
            <span class="label">All articles · {{ total }} article{{ "" if total == 1 else "s" }} · {{ groups | length }} source{{ "" if groups | length == 1 else "s" }}</span>
            <h1 class="display">What this run <em>judged</em></h1>
            <p class="small">Everything the run decided on, plus what is still pending. The digest shows a selection of it.</p>
            <div class="seg gated" role="group" aria-label="Article view" id="raw-views" hidden><button type="button" data-raw-view="list" aria-pressed="true">List</button><button type="button" data-raw-view="triage" aria-pressed="false">Triage</button></div>
        </div>

        <div id="raw-groups">
        {% for group in groups %}
        <section class="panel">
            <div class="panel-head"><span class="source-name">{{ group.name }}</span><span class="label">{{ group.articles | length }}</span></div>
            {% for a in group.articles %}
            <div class="raw-row">
                <span class="state {{ a.state }}">{{ a.state }}</span>
                <span class="score">{{ "%.2f" | format(a.score) if a.score is not none else "—" }}</span>
                <a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a>
                <span class="vote-group" data-urls='{{ [a.url] | tojson }}'><button class="btn sm secondary promote-btn" data-vote="up" title="More like this">↑</button><button class="btn sm secondary promote-btn" data-vote="down" title="Less like this">↓</button></span>
            </div>
            {% endfor %}
        </section>
        {% endfor %}
        </div>
        <div class="deck-wrap" id="raw-triage" hidden>
            <span class="label" id="t-remaining"></span>
            <article class="card" id="t-card"><span class="label" id="t-source"></span><h2 id="t-title"></h2></article>
            <div class="deck-actions" id="t-actions"><button class="btn danger" type="button" id="t-down" data-dir="down">Down</button><button class="btn primary" type="button" id="t-up" data-dir="up">Up</button></div>
            <p class="small" id="t-hint">Swipe left for down, right for up. Tap the card to open the article in a new tab.</p>
        </div>

        <div class="footer">// cyris</div>
    </div>
    {% include "_promote_script.html.j2" %}
    <script>
    // The rows are the only copy of the data, so the deck reads them: what is still
    // pending and not yet voted in this browser, in list order.
    const pool = () => [...document.querySelectorAll('.raw-row')].filter((row) =>
        row.querySelector('.state.pending')
        && !Object.hasOwn(votes, groupUrls(row.querySelector('.vote-group'))[0]));

    function renderDeck() {
        const rows = pool();
        document.getElementById('t-remaining').textContent = `${rows.length} remaining`;
        const [next] = rows;
        if (!next) return;
        document.getElementById('t-source').textContent =
            next.closest('.panel').querySelector('.source-name').textContent;
        document.getElementById('t-title').textContent = next.querySelector('a').textContent;
    }

    // List and Triage are two views of the same rows; switching never reloads.
    function setRawView(view) {
        for (const b of document.querySelectorAll('[data-raw-view]')) {
            b.setAttribute('aria-pressed', String(b.dataset.rawView === view));
        }
        document.getElementById('raw-groups').hidden = view !== 'list';
        document.getElementById('raw-triage').hidden = view !== 'triage';
        if (view === 'triage') renderDeck();
    }
    for (const b of document.querySelectorAll('[data-raw-view]')) {
        b.addEventListener('click', () => setRawView(b.dataset.rawView));
    }
    </script>
    {% include "_probe_script.html.j2" %}
</body>
</html>
