<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CYRIS // {{ date }} · {{ period }} · Raw</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        {% include "_tokens.css.j2" %}

        {% with container_width="900px", container_relative=false, glow=none, font_size=none, line_height="1.6", font_features=false %}{% include "_page.css.j2" %}{% endwith %}

        {% with masthead_padding="24px 0 20px", masthead_margin="40px", masthead_rule=false,
                  brand_margin="24px", mark_size="12px", mark_glow=false, mark_pulse=false,
                  brand_weight=none, subtitle_margin="14px",
                  h1_size="clamp(40px, 7vw, 72px)", h1_line_height="1", h1_tracking="-0.03em"  %}{% include "_masthead.css.j2" %}{% endwith %}

        .source-group {
            border: 1px solid var(--border);
            background: var(--bg-elev);
            margin-bottom: 20px;
        }

        .source-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
        }

        .source-name {
            font-weight: 600;
            font-size: 15px;
            letter-spacing: -0.01em;
        }

        .source-count {
            font-family: 'Geist Mono', monospace;
            font-size: 11px;
            letter-spacing: 0.12em;
            color: var(--text-faint);
            text-transform: uppercase;
        }

        .promote-btn {
            border: 1px solid var(--border);
            padding: 1px 7px;
            background: var(--surface);
            color: var(--text-dim);
            font-family: 'Geist Mono', monospace;
            font-size: 11px;
            cursor: pointer;
        }

        .promote-btn:hover { color: var(--text); }
        .promote-btn.done { color: var(--accent); border-color: var(--accent); }
        .promote-btn.error { color: #e06c75; border-color: #e06c75; }
        .vote-group { display: none; gap: 4px; }
        .settings-link { display: none; }

        .article {
            display: grid;
            grid-template-columns: 74px 46px 1fr auto;
            align-items: baseline;
            gap: 14px;
            padding: 11px 20px;
            border-bottom: 1px solid var(--border);
        }

        .article:last-child { border-bottom: none; }
        .article:hover { background: var(--surface); }

        .state {
            font-family: 'Geist Mono', monospace;
            font-size: 10px;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-faint);
        }

        .state.accepted { color: var(--accent); }
        .state.rejected { color: #6b4a4a; }

        .score {
            font-family: 'Geist Mono', monospace;
            font-size: 12px;
            color: var(--text-dim);
            text-align: right;
        }

        .article a {
            color: var(--text);
            text-decoration: none;
            border-bottom: 1px solid transparent;
        }

        .article a:hover {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        .footer {
            margin-top: 48px;
            padding-top: 20px;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
            font-family: 'Geist Mono', monospace;
            font-size: 11px;
            letter-spacing: 0.08em;
            color: var(--text-faint);
            text-transform: uppercase;
        }

        .footer a { color: var(--text-dim); text-decoration: none; }
        .footer a:hover { color: var(--accent); }

        @media (max-width: 640px) {
            .article {
                grid-template-columns: 74px 1fr auto;
                gap: 4px 14px;
                padding: 12px 16px;
            }
            .score { grid-column: 2; text-align: left; }
            .article a { grid-column: 1 / span 3; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="masthead">
            <div class="brand">
                <div class="brand-mark"></div>
                <div class="brand-name"><strong>CYRIS</strong> // Raw Feed</div>
            </div>
            <h1>This run's <em>verdicts</em>, plus pending</h1>
            <div class="subtitle">{{ date }} · {{ period | upper }} · {{ total }} articles · {{ groups | length }} sources</div>
        </header>

        {% for group in groups %}
        <section class="source-group">
            <div class="source-head">
                <span class="source-name">{{ group.name }}</span>
                <span class="source-count">{{ group.articles | length }}</span>
            </div>
            {% for a in group.articles %}
            <div class="article">
                <span class="state {{ a.state }}">{{ a.state }}</span>
                <span class="score">{{ "%.2f" | format(a.score) if a.score is not none else "—" }}</span>
                <a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a>
                <span class="vote-group" data-urls='{{ [a.url] | tojson }}'><button class="promote-btn" data-vote="up" title="More like this">↑</button><button class="promote-btn" data-vote="down" title="Less like this">↓</button></span>
            </div>
            {% endfor %}
        </section>
        {% endfor %}

        <div class="footer">
            <a href="{{ date }}-{{ period }}.html">← Back to digest</a>
            <a href="index.html">Archive →</a>
            <span class="settings-link"><a href="/settings">Settings →</a></span>
        </div>
    </div>
    {% include "_promote_script.html.j2" %}
</body>
</html>
