<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CYRIS // {{ date }} · {{ period }} · Raw</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        {% include "_tokens.css.j2" %}

        {% include "_components.css.j2" %}

        {% with container_width="900px", container_relative=false, glow=none, line_height="1.6", font_features=false %}{% include "_page.css.j2" %}{% endwith %}

        {% with masthead_padding="24px 0 20px", masthead_margin="40px", masthead_rule=false,
                  subtitle_margin="14px",
                  display_h1=true  %}{% include "_masthead.css.j2" %}{% endwith %}

        .source-group {
            border: 1px solid var(--border);
            background: var(--bg-elev);
            margin-bottom: 20px;
        }

        .source-head {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 16px;
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            background: var(--surface);
        }

        .source-name {
            font-weight: 600;
            font-size: calc(20px * var(--type-scale));
            letter-spacing: -0.01em;
        }

        .source-count {
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            letter-spacing: 0.12em;
            color: var(--text-faint);
            text-transform: uppercase;
        }

        {% include "_promote.css.j2" %}

        .article {
            display: grid;
            grid-template-columns: 96px 46px 1fr auto;
            align-items: baseline;
            gap: 14px;
            padding: 11px 20px;
            border-bottom: 1px solid var(--border);
        }

        .article:last-child { border-bottom: none; }
        .article:hover { background: var(--surface); }

        .score {
            font-family: var(--font-mono);
            font-size: calc(16px * var(--type-scale));
            color: var(--text-dim);
            text-align: right;
        }

        .article a {
            color: var(--text);
            text-decoration: none;
            border-bottom: 1px solid transparent;
        }

        .article a:hover {
            color: var(--accent);
            border-bottom-color: var(--accent);
        }

        {% with layout="flex", justify=false, align_center=false, margin_top="48px",
                  padding_top="20px", gap="24px", link_transition=false  %}{% include "_footer.css.j2" %}{% endwith %}

        @media (max-width: 640px) {
            .article {
                grid-template-columns: 96px 1fr auto;
                gap: 4px 14px;
                padding: 12px 16px;
            }
            .score { grid-column: 2; text-align: left; }
            .article a { grid-column: 1 / span 3; }
        }
    </style>
</head>
<body>
    <div class="container">
        <header class="masthead">
            <div class="brand">
                <div class="brand-mark"></div>
                <div class="brand-name"><strong>CYRIS</strong> // Raw Feed</div>
            </div>
            <h1>This run's <em>verdicts</em>, plus pending</h1>
            <div class="subtitle">{{ date }} · {{ period | upper }} · {{ total }} articles · {{ groups | length }} sources</div>
        </header>

        {% for group in groups %}
        <section class="source-group">
            <div class="source-head">
                <span class="source-name">{{ group.name }}</span>
                <span class="source-count">{{ group.articles | length }}</span>
            </div>
            {% for a in group.articles %}
            <div class="article">
                <span class="state {{ a.state }}">{{ a.state }}</span>
                <span class="score">{{ "%.2f" | format(a.score) if a.score is not none else "—" }}</span>
                <a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.title }}</a>
                <span class="vote-group" data-urls='{{ [a.url] | tojson }}'><button class="btn sm secondary promote-btn" data-vote="up" title="More like this">↑</button><button class="btn sm secondary promote-btn" data-vote="down" title="Less like this">↓</button></span>
            </div>
            {% endfor %}
        </section>
        {% endfor %}

        <div class="footer">
            <a href="{{ date }}-{{ period }}.html">← Back to digest</a>
            <a href="index.html">Archive →</a>
            <span class="settings-link"><a href="/settings">Settings →</a></span>
        </div>
    </div>
    {% include "_promote_script.html.j2" %}
    {% include "_probe_script.html.j2" %}
</body>
</html>
