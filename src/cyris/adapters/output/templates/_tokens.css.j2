        :root {
            --bg: #07070a;
            --bg-elev: #0d0d12;
            --surface: #11111a;
            --surface-2: #161622;
            --border: #1f1f2e;
            --border-strong: #2a2a40;
            --text: #ebebf2;
            --text-dim: #8a8aa0;
            --text-faint: #56566e;
            --accent: #c6ff3d;
            --accent-dim: #8aa829;
            --warn: #ff5b8a;
            --grid: rgba(198, 255, 61, 0.035);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
