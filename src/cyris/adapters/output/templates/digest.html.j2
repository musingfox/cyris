{% macro promote_btn(item, story_id=None) -%}
{% if item.urls %}<span class="vote-group"{% if story_id %} data-story-id="{{ story_id }}"{% endif %} data-urls='{{ item.urls | tojson }}'><button class="btn sm secondary promote-btn" data-vote="up" title="More like this">↑</button><button class="btn sm secondary promote-btn" data-vote="down" title="Less like this">↓</button></span>{% endif %}
{%- endmacro -%}
{#- Sources of a news cluster: one link per article, so a busy topic renders five of
    them and wraps into a mess on a phone. Fold past two behind a native <details>. -#}
{% macro source_links(item) -%}
{%- set urls = item.ref_urls if item.ref_urls else item.urls -%}
{%- for url in urls %}{% set label = url | hostname if item.ref_urls else item.sources[loop.index0] if loop.index0 < item.sources | length else url %}{% if url.startswith('http') %}<a href="{{ url }}" target="_blank" rel="noopener">{{ label }}</a>{% else %}{{ label }}{% endif %}{{ ' · ' if not loop.last }}{% endfor -%}
{%- endmacro -%}
{% macro source_list(item) -%}
{%- set urls = item.ref_urls if item.ref_urls else item.urls -%}
{% if urls | length > 2 %}<details class="src-fold"><summary>{{ urls | length }} sources</summary><span class="src-list">{{ source_links(item) }}</span></details>{% else %}{{ source_links(item) }}{% endif %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CYRIS // {{ date }} · {{ period }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        {% include "_tokens.css.j2" %}

        {% include "_components.css.j2" %}

        html { scroll-behavior: smooth; }

        {% with container_width="1240px", container_relative=true, glow="80% 60%", line_height="1.65", font_features=true %}{% include "_page.css.j2" %}{% endwith %}

        /* === MASTHEAD === */
        {% with masthead_padding="28px 0 24px", masthead_margin="48px", masthead_rule=true,
                  subtitle_margin="18px"  %}{% include "_masthead.css.j2" %}{% endwith %}

        .mast-row {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            gap: 24px;
            flex-wrap: wrap;
        }

        .meta-strip {
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            letter-spacing: 0.08em;
            color: var(--text-faint);
            text-transform: uppercase;
            display: flex;
            gap: 18px;
            align-items: center;
        }

        .meta-strip span.live::before {
            content: "●";
            color: var(--accent);
            margin-right: 6px;
            animation: pulse 2.4s ease-in-out infinite;
        }

        .headline-block {
            margin-top: 36px;
            display: grid;
            grid-template-columns: minmax(0, 1fr) 280px;
            gap: 48px;
            align-items: end;
        }

        .issue-title {
            font-family: var(--font-serif);
            font-weight: 400;
            font-size: calc(clamp(64px, 10vw, 136px) * var(--type-scale));
            line-height: 0.92;
            letter-spacing: -0.04em;
            color: var(--text);
        }

        .issue-title em {
            font-style: italic;
            color: var(--accent);
            font-feature-settings: "ss01";
        }

        .stats-card {
            border: 1px solid var(--border);
            background: var(--surface);
            padding: 18px 20px;
            font-family: var(--font-mono);
            font-size: calc(16px * var(--type-scale));
            color: var(--text-dim);
        }

        .stats-card .row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px dashed var(--border);
        }

        .stats-card .row:last-child { border-bottom: none; }

        .stats-card .label {
            font-size: calc(14px * var(--type-scale));
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-faint);
        }

        .stats-card .value {
            color: var(--text);
            font-weight: 500;
        }

        .stats-card .value.hl { color: var(--accent); }

        /* === SECTION HEADERS === */
        .section {
            margin-bottom: 64px;
            scroll-margin-top: 24px;
        }

        .section-tag {
            display: flex;
            align-items: center;
            gap: 12px;
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            letter-spacing: 0.16em;
            color: var(--text-faint);
            text-transform: uppercase;
            margin-bottom: 24px;
        }

        .section-tag::before {
            content: "";
            width: 24px;
            height: 1px;
            background: var(--accent);
        }

        .section-tag .id {
            color: var(--accent);
            font-weight: 500;
        }

        .section-heading {
            font-family: var(--font-sans);
            font-size: calc(28px * var(--type-scale));
            font-weight: 600;
            letter-spacing: -0.02em;
            line-height: 1.05;
            margin-bottom: 28px;
            color: var(--text);
        }

        .section-description {
            color: var(--text-dim);
            font-size: calc(20px * var(--type-scale));
            margin-bottom: 24px;
            max-width: 70ch;
        }

        /* === LEAD STORY === */
        .lead-story {
            position: relative;
            border: 1px solid var(--border);
            background: linear-gradient(180deg, var(--surface) 0%, var(--bg-elev) 100%);
            padding: 40px 44px;
            margin-bottom: 56px;
            overflow: hidden;
        }

        .lead-story::before {
            content: "TOP STORY";
            position: absolute;
            top: 20px;
            right: 28px;
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            letter-spacing: 0.22em;
            color: var(--accent);
            border: 1px solid var(--accent-dim);
            padding: 4px 10px;
            background: var(--accent-tint);
        }

        .lead-story::after {
            content: "";
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 3px;
            background: var(--accent);
            box-shadow: 0 0 24px var(--accent);
        }

        .lead-story h2 {
            font-family: var(--font-sans);
            font-size: calc(clamp(32px, 4.5vw, 52px) * var(--type-scale));
            font-weight: 600;
            line-height: 1.05;
            letter-spacing: -0.025em;
            margin-bottom: 20px;
            max-width: 24ch;
        }

        .lead-story h2 a {
            color: var(--text);
            text-decoration: none;
            background: none;
            border: none;
            transition: color var(--t-fast);
        }

        .lead-story h2 a:hover { color: var(--accent); }

        .lead-story .summary {
            font-size: calc(20px * var(--type-scale));
            line-height: 1.7;
            color: var(--text);
            max-width: 70ch;
            margin-bottom: 28px;
        }

        .lead-story .meta {
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            color: var(--text-faint);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
            align-items: center;
            padding-top: 20px;
            border-top: 1px dashed var(--border-strong);
        }

        /* === FEATURED GRID === */
        .featured-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
            gap: 1px;
            background: var(--border);
            margin-bottom: 56px;
            border: 1px solid var(--border);
        }

        .featured-item {
            background: var(--bg-elev);
            padding: 28px;
            transition: background-color var(--t-fast);
            position: relative;
        }

        .featured-item:hover {
            background: var(--surface);
        }

        .featured-item h3 {
            font-family: var(--font-sans);
            font-size: calc(22px * var(--type-scale));
            font-weight: 600;
            letter-spacing: -0.015em;
            line-height: 1.2;
            margin-bottom: 12px;
        }

        .featured-item h3 a {
            color: var(--text);
            border: none;
            background: none;
        }

        .featured-item h3 a:hover { color: var(--accent); }

        .featured-item .summary {
            font-size: calc(20px * var(--type-scale));
            line-height: 1.65;
            color: var(--text-dim);
            margin-bottom: 18px;
        }

        .featured-item .meta {
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            color: var(--text-faint);
            letter-spacing: 0.06em;
            text-transform: uppercase;
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
        }

        .source-tag {
            color: var(--text-dim);
        }

        /* === NEWS CLUSTERS === */
        .news-cluster {
            border-left: 2px solid var(--border-strong);
            padding: 18px 0 18px 22px;
            margin-bottom: 20px;
            transition: border-color var(--t-fast);
        }

        .news-cluster:hover {
            border-left-color: var(--accent);
        }

        .news-cluster h4 {
            font-size: calc(22px * var(--type-scale));
            font-weight: 600;
            letter-spacing: -0.01em;
            margin-bottom: 10px;
            color: var(--text);
        }

        .news-cluster .summary {
            font-size: calc(20px * var(--type-scale));
            color: var(--text-dim);
            line-height: 1.65;
        }

        .news-cluster .meta { margin-top: 10px; }

        /* === ARTICLE ITEM (Thematic) === */
        .thematic-block {
            margin-bottom: 36px;
        }

        .thematic-block h3 {
            font-family: var(--font-sans);
            font-size: calc(22px * var(--type-scale));
            font-weight: 600;
            letter-spacing: -0.015em;
            margin-bottom: 18px;
            display: flex;
            align-items: baseline;
            gap: 12px;
            color: var(--text);
        }

        .thematic-block h3::before {
            content: "▸";
            color: var(--accent);
            font-size: calc(14px * var(--type-scale));
        }

        .article-item {
            padding: 20px 0;
            border-bottom: 1px solid var(--border);
        }

        .article-item:last-child { border-bottom: none; }

        .article-item h4 {
            font-size: calc(20px * var(--type-scale));
            font-weight: 600;
            line-height: 1.35;
            margin-bottom: 10px;
            letter-spacing: -0.01em;
        }

        .article-item h4 a {
            color: var(--text);
            border: none;
            background: none;
        }

        .article-item h4 a:hover { color: var(--accent); }

        .article-item .summary {
            font-size: calc(20px * var(--type-scale));
            color: var(--text-dim);
            margin-bottom: 12px;
            line-height: 1.65;
        }

        .article-item .meta {
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            color: var(--text-faint);
            text-transform: uppercase;
            letter-spacing: 0.06em;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
        }

        /* === ATTENTION (2-col) === */
        .attention-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
            gap: 24px;
        }

        .attention-item {
            padding: 16px 18px;
            background: var(--bg-elev);
            border: 1px solid var(--border);
            transition: border-color var(--t-fast);
        }

        .attention-item:hover { border-color: var(--border-strong); }

        .attention-item h5 {
            font-size: calc(20px * var(--type-scale));
            font-weight: 600;
            margin-bottom: 8px;
            letter-spacing: -0.005em;
        }

        .attention-item h5 a {
            color: var(--text);
            border: none;
            background: none;
        }

        .attention-item h5 a:hover { color: var(--accent); }

        .attention-item .snippet {
            font-size: calc(20px * var(--type-scale));
            color: var(--text-dim);
            line-height: 1.55;
            margin-bottom: 10px;
        }

        .news-cluster .meta, .attention-item .meta {
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            color: var(--text-faint);
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        /* === HEADLINES (compact terminal-list) === */
        .headlines-compact {
            border: 1px solid var(--border);
            background: var(--bg-elev);
            padding: 4px 0;
        }

        .headline-item {
            display: flex;
            align-items: baseline;
            gap: 14px;
            padding: 10px 22px;
            font-size: calc(16px * var(--type-scale));
            line-height: 1.5;
            border-bottom: 1px dashed var(--border);
            transition: background-color var(--t-fast);
        }

        .headline-item:hover { background: var(--surface); }
        .headline-item:last-child { border-bottom: none; }

        .headline-item .idx {
            font-family: var(--font-mono);
            font-size: calc(16px * var(--type-scale));
            color: var(--accent-dim);
            min-width: 36px;
            letter-spacing: 0.05em;
        }

        .headline-item .text { flex: 1; color: var(--text); }

        .headline-item .text a {
            color: inherit;
            border: none;
            background: none;
        }

        .headline-item .text a:hover { color: var(--accent); }

        /* === FOOTER === */
        {% with layout="flex", justify=true, align_center=true, margin_top="80px",
                  padding_top="32px", gap="18px", link_transition=true  %}{% include "_footer.css.j2" %}{% endwith %}

        /* === GENERIC LINK === */
        /* :where() keeps these at a bare `a`'s specificity, so every link rule
           above still wins exactly as it did, while links outside the digest's
           content (the bars) keep their inherited colour. */
        :where(main) a {
            color: var(--accent);
            text-decoration: none;
            background: none;
            border: none;
        }

        :where(main) a:hover { color: var(--text); }

        /* === RESPONSIVE === */
        @media (max-width: 880px) {
            .container { padding: 16px 12px 60px; }
            .headline-block { grid-template-columns: 1fr; gap: 24px; }
            .stats-card { max-width: 100%; }
            .lead-story { padding: 28px 24px; }
            .lead-story::before { top: 14px; right: 16px; }
            .featured-grid { grid-template-columns: 1fr; }
            .attention-list { grid-template-columns: 1fr; }
            .section { margin-bottom: 48px; }
            .meta-strip { gap: 12px; }
        }
        {% include "_promote.css.j2" %}

        /* Folded cluster sources. inline-block keeps the vote buttons on the same row. */
        .src-fold { display: inline-block; }
        .src-fold > summary {
            cursor: pointer;
            list-style: none;
            color: var(--text-dim);
            text-decoration: underline dotted;
            text-underline-offset: 3px;
        }
        .src-fold > summary::-webkit-details-marker { display: none; }
        .src-fold > summary::after { content: ' ▾'; }
        .src-fold[open] > summary::after { content: ' ▴'; }
        .src-list { display: block; padding-top: 4px; }
    </style>
</head>
<body>
    <div class="container">
        <header class="masthead">
            <div class="mast-row">
                <div class="brand">
                    <div class="brand-mark"></div>
                    <div class="brand-name"><strong>CYRIS</strong> // Daily Digest</div>
                </div>
                <div class="meta-strip">
                    <span class="live">Live</span>
                    <span>{{ date }}</span>
                    <span>{{ period | upper }}</span>
                </div>
            </div>
            <div class="headline-block">
                <h1 class="issue-title">Signal<em>/</em>Noise</h1>
                <aside class="stats-card">
                    <div class="row">
                        <span class="label">Sources</span>
                        <span class="value">{{ sources_processed }}</span>
                    </div>
                    <div class="row">
                        <span class="label">Received</span>
                        <span class="value">{{ articles_received }}</span>
                    </div>
                    <div class="row">
                        <span class="label">Included</span>
                        <span class="value hl">{{ articles_included }}</span>
                    </div>
                    {% if triage_pending_count %}
                    <div class="row">
                        <span class="label">Triage</span>
                        <span class="value">{{ triage_pending_count }} awaiting triage</span>
                    </div>
                    {% endif %}
                </aside>
            </div>
        </header>

        <main>
            {% if lead_story %}
            <article class="lead-story">
                <h2>
                    {% if lead_story.link %}<a href="{{ lead_story.link }}" target="_blank" rel="noopener">{{ lead_story.title }}</a>{% else %}{{ lead_story.title }}{% endif %}
                </h2>
                <p class="summary">{{ lead_story.summary }}</p>
                <div class="meta">
                    {% if lead_story.score %}<span class="pill score">Score: {{ "%.1f" | format(lead_story.score) }}</span>{% endif %}
                    <span class="source-tag">Source: {{ lead_story.sources | join(' · ') }}</span>{% if lead_story.ref_urls | length > 1 %} {{ source_list(lead_story) }}{% endif %}
                    {% if lead_story.link %}<a href="{{ lead_story.link }}" target="_blank" rel="noopener">Read more →</a>{% endif %}
                    {{ promote_btn(lead_story) }}
                </div>
            </article>
            {% endif %}

            {% if featured_articles %}
            <section class="section">
                <div class="section-tag"><span class="id">02</span><span>Features</span></div>
                <div class="featured-grid">
                    {% for item in featured_articles %}
                    <article class="featured-item">
                        <h3>{% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h3>
                        <p class="summary">{{ item.summary }}</p>
                        <div class="meta">
                            {% if item.score %}<span class="pill score">{{ "%.1f" | format(item.score) }}</span>{% endif %}
                            <span class="source-tag">{{ item.sources | join(' · ') }}</span>{% if item.ref_urls | length > 1 %} {{ source_list(item) }}{% endif %}
                            {% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener">↗</a>{% endif %}
                            {{ promote_btn(item) }}
                        </div>
                    </article>
                    {% endfor %}
                </div>
            </section>
            {% endif %}

            {% if news_clusters %}
            <section class="section">
                <div class="section-tag"><span class="id">03</span><span>In Focus</span></div>
                <h2 class="section-heading">In Focus</h2>
                {% for cluster in news_clusters %}
                <div class="news-cluster">
                    <h4>{{ cluster.heading }}</h4>
                    {% for item in cluster.items %}
                    <div class="summary">{{ item.summary }}</div>
                    {#- The vote is on the topic, so one group per cluster; the links stay per article.
                        sources and urls are appended in lockstep by cluster_news, hence the shared index. -#}
                    <div class="meta">
                        {{ source_list(item) }}
                        {{ promote_btn(item, cluster.story_id) }}
                    </div>
                    {% endfor %}
                </div>
                {% endfor %}
            </section>
            {% endif %}

            {% if fan_sections %}
            <section class="section">
                <div class="section-tag"><span class="id">◆</span><span>Following</span></div>
                <h2 class="section-heading">Following</h2>
                {% for sec in fan_sections %}
                <div class="thematic-block">
                    <h3>{{ sec.heading }}</h3>
                    {% for item in sec.items %}
                    <article class="article-item">
                        <h4>{% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h4>
                        {% if item.summary %}<p class="summary">{{ item.summary }}</p>{% endif %}
                        <div class="meta">
                            <span class="source-tag">{{ item.sources | join(' · ') }}</span>{% if item.ref_urls | length > 1 %} {{ source_list(item) }}{% endif %}
                            {% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener">↗</a>{% endif %}
                            {{ promote_btn(item) }}
                        </div>
                    </article>
                    {% endfor %}
                </div>
                {% endfor %}
            </section>
            {% endif %}

            {% if attention_sections %}
            <section class="section">
                <div class="section-tag"><span class="id">04</span><span>On the Radar</span></div>
                <h2 class="section-heading">On the Radar</h2>
                {% for sec in attention_sections %}
                <div class="thematic-block">
                    <h3>{{ sec.heading }}</h3>
                    {% if sec.description %}<p class="section-description">{{ sec.description }}</p>{% endif %}
                    <div class="attention-list">
                        {% for item in sec.items %}
                        <article class="attention-item">
                            <h5>{% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</h5>
                            <p class="snippet">{{ item.summary }}</p>
                            <div class="meta"><span class="source-tag">{{ item.sources | join(' · ') }}</span>{% if item.ref_urls | length > 1 %} {{ source_list(item) }}{% endif %} {{ promote_btn(item) }}</div>
                        </article>
                        {% endfor %}
                    </div>
                </div>
                {% endfor %}
            </section>
            {% endif %}

            {% if filtered_headlines %}
            <section class="section">
                <div class="section-tag"><span class="id">05</span><span>The Wire</span></div>
                <h2 class="section-heading">The Wire</h2>
                <div class="headlines-compact">
                    {% for item in filtered_headlines %}
                    <div class="headline-item">
                        <span class="idx">{{ "%03d" | format(loop.index) }}</span>
                        <span class="text">{% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}</span>
                        {% if item.ref_urls | length > 1 %}{{ source_list(item) }}{% endif %}
                        {{ promote_btn(item) }}
                    </div>
                    {% endfor %}
                </div>
            </section>
            {% endif %}
        </main>

        <footer class="footer">
            <div>// Generated by Cyris &middot; {{ usage.total_tokens }} tokens &middot; {{ usage.api_calls }} api calls</div>
            <div><a href="{{ date }}-{{ period }}-raw.html">This run's verdicts →</a> &middot; <a href="index.html">View archive →</a><span class="settings-link"> &middot; <a href="/settings">Settings →</a></span></div>
        </footer>
    </div>
    {% include "_promote_script.html.j2" %}
</body>
</html>
