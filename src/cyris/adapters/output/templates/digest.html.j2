{% macro promote_btn(item, story_id=None) -%}
{% if item.urls %}<span class="vote-group"{% if story_id %} data-story-id="{{ story_id }}"{% endif %} data-urls='{{ item.urls | tojson }}' lang="en"><button class="btn sm secondary promote-btn" data-vote="up" title="More like this" aria-label="More like this" aria-pressed="false">↑</button><button class="btn sm secondary promote-btn" data-vote="down" title="Less like this" aria-label="Less like this" aria-pressed="false">↓</button></span>{% endif %}
{%- endmacro -%}
{% macro title_link(item) -%}
{% if item.link %}<a href="{{ item.link }}" target="_blank" rel="noopener">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
{%- endmacro -%}
{% macro tag_pills(tags) -%}
{% if tags %}<div class="tags">{% for tag in tags %}<span class="pill" lang="">{{ tag }}</span>{% endfor %}</div>{% endif %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="dark">
    <title>CYRIS // {{ date }} · {{ period }}</title>
    <meta name="description" content="The {{ date }} {{ period }} issue of a Cyris digest: {{ articles_included | plural('article') }} selected from {{ articles_received }}.">
    <link rel="icon" href="favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800;900&family=Geist+Mono:wght@300;400;500;600&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        {% include "_tokens.css.j2" %}

        {% include "_components.css.j2" %}

        html { scroll-behavior: smooth; }

        {% with container_width="1240px", container_relative=true, line_height="1.65", font_features=true %}{% include "_page.css.j2" %}{% endwith %}

        /* === MASTHEAD === */
        {% with masthead_padding="var(--s-8) 0 var(--s-6)", masthead_margin="var(--s-12)",
                  subtitle_margin="var(--s-5)"  %}{% include "_masthead.css.j2" %}{% endwith %}

        .headline-block {
            margin-top: var(--s-8);
            display: grid;
            /* The stats column narrows with the page, so the fallback-font title,
               wider than Instrument Serif, clears it from 721px up. */
            grid-template-columns: minmax(0, 1fr) min(37vw, 320px);
            gap: var(--s-12);
            align-items: end;
            /* The fallback font sets the title wider than a phone's column until the
               webfont lands; clip, not hidden, so the italic's overhang still shows. */
            overflow-x: clip;
        }

        .issue-title {
            font-family: var(--font-serif);
            font-weight: 400;
            font-size: calc(clamp(56px, 8.75vw, 119px) * var(--type-scale));
            line-height: 0.92;
            letter-spacing: -0.04em;
            color: var(--text);
        }

        .issue-title em {
            font-style: italic;
            color: var(--accent);
            font-feature-settings: "ss01";
        }

        .stats-card {
            border: 1px solid var(--border);
            background: var(--surface);
            padding: var(--s-4) var(--s-5);
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            color: var(--text-dim);
        }

        .stats-card .row {
            display: flex;
            justify-content: space-between;
            padding: var(--s-2) 0;
            border-bottom: 1px dashed var(--border);
        }

        .stats-card .row:last-child { border-bottom: none; }

        .stats-card .value {
            color: var(--text);
            font-weight: 500;
        }

        .stats-card .value.hl { color: var(--accent); }

        /* === SECTION HEADERS === */
        .section {
            margin-bottom: var(--s-16);
        }

        .section-tag {
            display: flex;
            align-items: center;
            gap: var(--s-3);
            font-size: calc(12px * var(--type-scale));
            margin-bottom: var(--s-5);
        }

        .section-tag::before {
            content: "";
            width: 24px;
            height: 1px;
            background: var(--accent);
        }

        .issue-note {
            margin-bottom: var(--s-12);
            max-width: var(--measure-wide);
        }

        /* === META ROWS === */
        /* One row model for every item: flex, so a vote group is a flex item
           whatever display the vote probe gives it. Its type is the .label role. */
        .meta {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: var(--s-3);
            font-family: var(--font-mono);
            font-weight: 500;
            font-size: calc(12px * var(--type-scale));
            text-transform: uppercase;
            letter-spacing: .1em;
            color: var(--text-dim);
        }

        /* The original link is a 44px box, its glyph centred: a centred tap area
           would reach over the source names and votes beside it (spec section 4). */
        .orig { display: inline-flex; justify-content: center; min-width: 44px; position: relative; }
        .orig::after { content: ""; position: absolute; inset: min(0px, calc((100% - 44px) / 2)); }

        /* === ITEM TITLES (spec title role; the class sets 18 or 19px) === */
        .item-title {
            font-size: calc(18px * var(--type-scale));
            font-weight: 600;
            line-height: 1.3;
            color: var(--text);
        }

        .item-title.lg { font-size: calc(19px * var(--type-scale)); }

        .item-title a {
            color: var(--text);
            border: none;
            background: none;
        }

        .item-title a:hover { color: var(--accent); }

        /* === FEATURED GRID === */
        .featured-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
            margin-bottom: var(--s-12);
            border-top: 1px solid var(--border);
            border-left: 1px solid var(--border);
        }

        /* Each card draws its own right and bottom hairline, so a short last row
           leaves its empty cells as page, not a border-coloured block. */
        .featured-item {
            background: var(--bg-elev);
            border-right: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            padding: var(--s-6);
            transition: background-color var(--t-fast);
            position: relative;
            /* A column, so the meta row can take the space a shorter card leaves: the
               cards of one grid row are one height, and their meta rows line up at the foot. */
            display: flex;
            flex-direction: column;
        }

        /* The meta row is the last child, or the one before a refused vote's notice; it
           is named by position because every .meta shares one base rule
           (tests/test_ui_spec.py). The :not keeps the notice from sharing the slack. */
        .featured-item > :last-child:not(.vote-error), .featured-item > :has(+ .vote-error) { margin-top: auto; }
        /* A flex column does not collapse margins: the summary's margin alone keeps the
           space above the tags that the block layout's collapse left there. */
        .featured-item .tags { margin-top: 0; }

        .featured-item:hover {
            background: var(--surface);
        }

        .featured-item h3 { margin-bottom: var(--s-3); }

        .featured-item .summary {
            font-size: calc(18px * var(--type-scale));
            line-height: 1.65;
            color: var(--text-dim);
            margin-bottom: var(--s-4);
            max-width: var(--measure-wide);
        }

        .source-tag {
            color: var(--text-dim);
        }

        /* === NEWS CLUSTERS === */
        .news-cluster {
            border-left: 2px solid var(--border-strong);
            padding: var(--s-4) 0 var(--s-4) var(--s-5);
            margin-bottom: var(--s-5);
            transition: border-color var(--t-fast);
        }

        .news-cluster:hover {
            border-left-color: var(--accent);
        }

        .news-cluster h3 { margin-bottom: var(--s-2); }

        .news-cluster .summary {
            font-size: calc(18px * var(--type-scale));
            color: var(--text-dim);
            line-height: 1.65;
            margin-bottom: var(--s-2);
            max-width: var(--measure-wide);
        }

        /* === TRACKING === */
        .thematic-block {
            margin-bottom: var(--s-8);
        }

        .thematic-block h3 {
            margin-bottom: var(--s-4);
            display: flex;
            align-items: baseline;
            gap: var(--s-3);
        }

        .thematic-block h3::before {
            content: "▸";
            color: var(--accent);
            font-size: calc(12px * var(--type-scale));
        }

        .article-item {
            padding: var(--s-5) 0;
            border-bottom: 1px solid var(--border);
        }

        .article-item:last-child { border-bottom: none; }

        .article-item h4 { margin-bottom: var(--s-2); }

        /* === HEADLINES (compact terminal-list) === */
        .headlines-compact {
            border: 1px solid var(--border);
            background: var(--bg-elev);
            padding: var(--s-1) 0;
        }

        .headline-item {
            display: flex;
            align-items: baseline;
            gap: var(--s-3);
            padding: var(--s-2) var(--s-5);
            font-size: calc(14px * var(--type-scale));
            line-height: 1.5;
            border-bottom: 1px dashed var(--border);
            transition: background-color var(--t-fast);
        }

        .headline-item:hover { background: var(--surface); }
        .headline-item:last-child { border-bottom: none; }

        .headline-item .idx {
            font-family: var(--font-mono);
            font-size: calc(14px * var(--type-scale));
            color: var(--accent-dim);
            min-width: 36px;
            letter-spacing: 0.05em;
        }

        .headline-item .text { flex: 1; color: var(--text); }

        .headline-item .text a {
            color: inherit;
            border: none;
            background: none;
        }

        .headline-item .text a:hover { color: var(--accent); }

        .headline-item .summary {
            font-size: calc(14px * var(--type-scale));
            color: var(--text-dim);
            line-height: 1.5;
            margin-top: var(--s-1);
            max-width: var(--measure-wide);
            overflow-wrap: anywhere;
        }

        /* === FOOTER === */
        {% include "_footer.css.j2" %}

        /* === GENERIC LINK === */
        /* :where() keeps these at a bare `a`'s specificity, so every link rule
           above still wins exactly as it did, while links outside the digest's
           content (the bars) keep their inherited colour. */
        :where(main) a {
            color: var(--accent);
            text-decoration: none;
            background: none;
            border: none;
        }

        :where(main) a:hover { color: var(--text); }

        /* === RESPONSIVE === */
        @media (max-width: 720px) {
            .section { margin-bottom: var(--s-12); }
            .headline-block { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
        }
        {% include "_promote.css.j2" %}

        /* Folded cluster sources. inline-block keeps the vote buttons on the same row. */
        .src-fold { display: inline-block; }
        .src-fold > summary {
            cursor: pointer;
            list-style: none;
            color: var(--text-dim);
            text-decoration: underline dotted;
            text-underline-offset: 3px;
        }
        .src-fold > summary::-webkit-details-marker { display: none; }
        .src-fold > summary::after { content: ' ▾'; }
        .src-fold[open] > summary::after { content: ' ▴'; }
        .src-list { display: block; padding-top: var(--s-1); }
        .src-member { display: block; }

        /* An item's tags take their own row, so however many there are the votes stay
           on the meta row beside the fold or the source. */
        .tags { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-2); }
    </style>
</head>
<body>
    {% include "_site_bar.html.j2" %}
    {% with view="digest" %}{% include "_issue_bar.html.j2" %}{% endwith %}
    <div class="container">
        <header class="masthead">
            <div class="headline-block">
                <h1 class="issue-title">Signal<em>/</em>Noise</h1>
                <aside class="stats-card">
                    <div class="row">
                        <span class="label">Sources</span>
                        <span class="value">{{ sources_processed }}</span>
                    </div>
                    <div class="row">
                        <span class="label">Received</span>
                        <span class="value">{{ articles_received }}</span>
                    </div>
                    <div class="row">
                        <span class="label">Included</span>
                        <span class="value hl">{{ articles_included }}</span>
                    </div>
                    {% if triage_pending_count %}
                    <div class="row">
                        <span class="label">Triage</span>
                        <span class="value">{{ triage_pending_count }} awaiting triage</span>
                    </div>
                    {% endif %}
                </aside>
            </div>
        </header>

        <main>
            {% if degraded %}
            <p class="notice err issue-note">Some or all of this issue is unscored or plain excerpts: the configured LLM could not be used for every step this run. Check the provider and its key on Settings.</p>
            {% endif %}
            {% if not articles_included %}
            <p class="small issue-note">Nothing is in this issue: this run judged the {{ articles_received }} articles it received and kept none.{% if raw_page %} <a href="{{ date }}-{{ period }}-raw.html">All articles</a> lists each one with its verdict.{% endif %}</p>
            {% endif %}
            {#- Above the layers because a topic is something the reader asked to see. Its
                hits are links only: a hit is a view of the run's candidates, not an item of
                the issue, so it carries no vote. Trimmed both ends, so an issue with no hit
                renders byte for byte as it did before tracking existed. -#}
            {%- if layers.tracking %}

            <section class="section">
                <h2 class="section-tag"><span class="label">Tracking</span></h2>
                {% for topic in layers.tracking %}
                <div class="thematic-block" lang="">
                    <h3 class="item-title lg">{{ topic.heading }}</h3>
                    {% for item in topic.items %}
                    <article class="article-item">
                        <h4 class="item-title">{{ title_link(item) }}</h4>
                    </article>
                    {% endfor %}
                </div>
                {% endfor %}
            </section>
            {%- endif %}

            {#- Pebble: one card per read or follow article, the one place a source is named. -#}
            {%- if layers.pebbles %}

            <section class="section">
                <h2 class="section-tag"><span class="label">Stories</span></h2>
                <div class="featured-grid" lang="{{ content_lang }}">
                    {% for pebble in layers.pebbles %}{% set item = pebble.item %}
                    <article class="featured-item"{% if pebble.untranslated %} lang=""{% endif %}>
                        <h3 class="item-title lg" lang="">{{ title_link(item) }}</h3>
                        {% if item.summary %}<p class="summary">{{ item.summary }}</p>{% endif %}
                        {{ tag_pills(item.tags) }}
                        <div class="meta">
                            <span class="source-tag">{{ item.sources | join(' · ') }}</span>
                            {% if item.link %}<a class="orig" href="{{ item.link }}" target="_blank" rel="noopener">↗</a>{% endif %}
                            {{ promote_btn(item) }}
                        </div>
                    </article>
                    {% endfor %}
                </div>
            </section>
            {%- endif %}

            {#- Sand: one block per topic of two or more articles, with one vote over all of
                them. Its articles and their sources stay folded until the reader opens them. -#}
            {%- if layers.sand %}

            <section class="section">
                <h2 class="section-tag"><span class="label">Topics</span></h2>
                {% for sand in layers.sand %}
                <div class="news-cluster" lang="{{ content_lang }}">
                    <h3 class="item-title lg">{{ sand.heading }}</h3>
                    {% if sand.line %}<p class="summary"{% if sand.line_untranslated %} lang=""{% endif %}>{{ sand.line }}</p>{% endif %}
                    {{ tag_pills(sand.tags) }}
                    <div class="meta">
                        <details class="src-fold"><summary lang="en">{{ sand.members | length | plural('article') }}</summary><span class="src-list" lang="">{% for member in sand.members %}<span class="src-member">{{ title_link(member) }}{% if member.sources %} <span class="source-tag">{{ member.sources | join(' · ') }}</span>{% endif %}</span>{% endfor %}</span></details>
                        {{ promote_btn(sand.vote, sand.story_id) }}
                    </div>
                </div>
                {% endfor %}
            </section>
            {%- endif %}

            {#- Water: one row per topic of one article and per headline. -#}
            {%- if layers.water %}

            <section class="section">
                <h2 class="section-tag"><span class="label">Headlines</span></h2>
                <div class="headlines-compact" lang="{{ content_lang }}">
                    {% for water in layers.water %}{% set item = water.item %}
                    <div class="headline-item"{% if water.untranslated %} lang=""{% endif %}>
                        <span class="idx">{{ "%03d" | format(loop.index) }}</span>
                        <div class="text">{{ title_link(item) }}{% if item.summary %}<p class="summary">{{ item.summary }}</p>{% endif %}{{ tag_pills(water.tags) }}</div>
                        {{ promote_btn(item, water.story_id) }}
                    </div>
                    {% endfor %}
                </div>
            </section>
            {%- endif %}
        </main>

        <footer class="footer">
            <div>// Generated by <a href="{{ project_url }}">Cyris</a> &middot; {{ usage.total_tokens }} tokens &middot; {{ usage.api_calls }} api calls</div>
        </footer>
    </div>
    {% include "_promote_script.html.j2" %}
    {% include "_progress_script.html.j2" %}
    {% include "_probe_script.html.j2" %}
</body>
</html>
