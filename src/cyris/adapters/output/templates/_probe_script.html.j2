    <script>
    // Capability probe: check if /api/vote is available before showing buttons and Settings.
    // Contract (do not follow Access redirects):
    // - Access redirect (opaqueredirect) → Sign in shows
    // - 200 JSON {"authorized":true} → vote buttons, Settings and gated controls show
    // - anything else (the Worker's 403, a non-ok status such as a 404 on a host with no
    //   Worker, a 200 that is not authorized JSON, a failed fetch) → nothing shows
    (async () => {
        try {
            const resp = await fetch('/api/vote', {
                method: 'GET',
                redirect: 'manual',  // do not follow Access redirects
            });
            if (resp.type === 'opaqueredirect') return showSignIn();
            if (resp.status === 403) return;
            if (!resp.ok) return;
            const data = await resp.json();
            if (data.authorized !== true) return;
            // Authorized: show vote buttons, the Settings link, and any control or link marked gated
            document.querySelectorAll('.vote-group').forEach((g) => g.style.display = 'inline-flex');
            document.querySelectorAll('.settings-link').forEach((s) => s.style.display = 'inline');
            document.querySelectorAll('.gated').forEach((g) => g.hidden = false);
            document.querySelectorAll('[data-gated-href]').forEach((a) => a.href = a.dataset.gatedHref);
        } catch {
            // Parse error, network failure, or CORS → nothing shows; the controls stay hidden
        }
        // Sign in is the one control a reader who is not admitted can use: it links /login with this page as next.
        function showSignIn() {
            const next = encodeURIComponent(location.pathname + location.search);
            document.querySelectorAll('.signin-link').forEach((a) => {
                a.href = '/login?next=' + next;
                a.hidden = false;
            });
        }
    })();
    </script>
