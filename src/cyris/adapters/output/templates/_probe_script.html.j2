    <script>
    // Capability probe: check if /api/vote is available before showing buttons and Settings.
    // Contract (do not follow Access redirects):
    // - Access redirect (opaqueredirect) → Sign in shows
    // - 200 JSON {"authorized":true} (the app Worker, and a local `cyris triage-ui`, which takes
    //   votes itself, ADR-0044) → vote buttons, Settings, the Archive link and gated controls show
    // - 200 JSON {"authorized":true,"votes":false} (a settings server with no article store to
    //   take a vote into) → Settings and the Archive link show; vote buttons and gated controls
    //   stay closed. The other answers carry no `votes` field, so only `votes === false` closes them.
    // - 200 JSON {"authorized":true,"settings":false,"settings_link":true} (a hosted tenant's page,
    //   ADR-0039 and ADR-0040: the hosted Worker takes votes and serves the tenant's own settings
    //   page, but no archive link or interest page) → the vote buttons and the Settings link show;
    //   the gated controls stay closed. Only `settings === false` closes them, and only
    //   `settings_link === true` opens the Settings link without them. The hosted Worker answers a
    //   request carrying the page's vote token (its <meta name="cyris-vote-token">) and refuses
    //   one without.
    // - anything else (the Worker's 403, a non-ok status such as a 404 on a host with no
    //   Worker, a 200 that is not authorized JSON, a failed fetch) → nothing shows
    (async () => {
        try {
            const voteToken = document.querySelectorAll('meta[name="cyris-vote-token"]')[0]?.content;
            const resp = await fetch('/api/vote', {
                method: 'GET',
                redirect: 'manual',  // do not follow Access redirects
                ...(voteToken ? { headers: { 'X-Cyris-Vote': voteToken } } : {}),
            });
            if (resp.type === 'opaqueredirect') return showSignIn();
            if (resp.status === 403) return;
            if (!resp.ok) return;
            const data = await resp.json();
            if (data.authorized !== true) return;
            // Authorized: show the Settings link and the Archive link, and point the brand at the archive
            const settings = data.settings !== false;
            if (settings || data.settings_link === true) {
                document.querySelectorAll('.settings-link').forEach((s) => s.style.display = 'inline');
            }
            if (settings) {
                document.querySelectorAll('.archive-link').forEach((a) => a.hidden = false);
                document.querySelectorAll('[data-gated-href]').forEach((a) => a.href = a.dataset.gatedHref);
            }
            // This server takes no vote: leave the vote buttons and the gated controls closed
            if (data.votes === false) return;
            document.querySelectorAll('.vote-group').forEach((g) => g.style.display = 'inline-flex');
            if (settings) document.querySelectorAll('.gated').forEach((g) => g.hidden = false);
        } catch {
            // Parse error, network failure, or CORS → nothing shows; the controls stay hidden
        }
        // Sign in is the one control a reader who is not admitted can use: it links /login with this page as next.
        function showSignIn() {
            const next = encodeURIComponent(location.pathname + location.search);
            document.querySelectorAll('.signin-link').forEach((a) => {
                a.href = '/login?next=' + next;
                a.hidden = false;
            });
        }
    })();
    </script>
