{#- One issue as a mail body. Every colour arrives by value through `c`, and the
    palette macro is rendered twice: light as the default, the page's own dark
    tokens under prefers-color-scheme. Layout rules take `tok`, the same tokens. -#}
{% macro palette(c) -%}
        body, .body { background: {{ c['bg'] }}; color: {{ c['text'] }}; }
        .brand, .section-tag, .meta, .footer { color: {{ c['text-dim'] }}; }
        .mark, .rule { background: {{ c['accent'] }}; }
        .issue-title, .title, .title a, .lead-title, .lead-title a { color: {{ c['text'] }}; }
        .stats b { color: {{ c['accent'] }}; }
        .stats, .summary, .desc, .desc a, .meta a, .footer a { color: {{ c['text-dim'] }}; }
        .btn.primary { background: {{ c['accent'] }}; border-color: {{ c['accent'] }}; color: {{ c['bg'] }}; }
        .btn.secondary { background: {{ c['surface-2'] }}; border-color: {{ c['border-strong'] }}; color: {{ c['text-dim'] }}; }
        .notice { border-left-color: {{ c['warn'] }}; background: {{ c['warn-tint'] }}; color: {{ c['text'] }}; }
        .lead { background: {{ c['surface'] }}; border-color: {{ c['border-strong'] }}; }
        .pill { color: {{ c['accent'] }}; border-color: {{ c['accent-dim'] }}; background: {{ c['accent-tint'] }}; }
        .item, .footer { border-color: {{ c['border'] }}; }
{%- endmacro -%}
{#- A cluster's sources, one link per article: the page's own labelling rule. -#}
{% macro source_links(item) -%}
{%- set urls = item.ref_urls if item.ref_urls else item.urls -%}
{%- for url in urls %}{% set label = url | hostname if item.ref_urls else item.sources[loop.index0] if loop.index0 < item.sources | length else url %}{% if url.startswith('http') %}<a href="{{ url }}">{{ label }}</a>{% else %}{{ label }}{% endif %}{{ ' · ' if not loop.last }}{% endfor -%}
{%- endmacro -%}
{#- A news paragraph's citations, one link per cited article. -#}
{% macro paragraph_sources(paragraph) -%}
{%- for label, url in paragraph | paragraph_links %}{% if url %}<a href="{{ url }}">{{ label }}</a>{% else %}{{ label }}{% endif %}{{ ' · ' if not loop.last }}{% endfor -%}
{%- endmacro -%}
{% macro title_link(item) -%}
{% if item.link %}<a href="{{ item.link }}">{{ item.title }}</a>{% else %}{{ item.title }}{% endif %}
{%- endmacro -%}
{% macro meta(item) -%}
<p class="meta">{{ item.sources | join(' · ') }}{% if item.ref_urls | length > 1 %} · {{ source_links(item) }}{% endif %}</p>
{%- endmacro -%}
{#- A summarize group's articles under its one summary, each with its own link. -#}
{% macro members(story) -%}
{% for item in story.members %}
<div class="member">
    {% if item.score is not none %}<span class="pill">{{ "%.1f" | format(item.score) }}</span>{% endif %}
    <h4 class="title" lang="">{{ title_link(item) }}</h4>
    {{ meta(item) }}
</div>
{% endfor %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="{{ ui_lang }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <title>CYRIS // {{ issue_name(content.date, content.started_at) }}</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap">
    <style>
        :root { color-scheme: light dark; supported-color-schemes: light dark; }
        body, .body { margin: 0; padding: 0; -webkit-text-size-adjust: 100%; }
        .wrap { max-width: {{ tok['measure'] }}; margin: 0 auto; padding: {{ tok['s-8'] }} {{ tok['s-4'] }} {{ tok['s-12'] }}; font-family: {{ tok['font-sans'] }}; }
        .preheader { display: none; max-height: 0; overflow: hidden; mso-hide: all; font-size: 1px; line-height: 1px; opacity: 0; }
        .brand, .section-tag, .meta, .btn { font-family: {{ tok['font-mono'] }}; font-weight: 500; font-size: 12px; text-transform: uppercase; letter-spacing: .1em; }
        .brand { margin: 0 0 {{ tok['s-5'] }}; }
        .mark { display: inline-block; width: 12px; height: 12px; vertical-align: -1px; margin-right: {{ tok['s-3'] }}; }
        .issue-title { font-family: {{ tok['font-serif'] }}; font-weight: 400; font-size: 56px; line-height: .92; letter-spacing: -.04em; margin: 0 0 {{ tok['s-5'] }}; }
        .stats { font-family: {{ tok['font-mono'] }}; font-size: 14px; font-variant-numeric: tabular-nums; margin: 0 0 {{ tok['s-6'] }}; }
        .stats b { font-weight: 500; }
        .actions { margin: 0 0 {{ tok['s-12'] }}; }
        .btn { display: inline-block; padding: {{ tok['s-3'] }} {{ tok['s-5'] }}; line-height: 18px; border: 1px solid; border-radius: {{ tok['r-control'] }}; text-decoration: none; margin: 0 {{ tok['s-2'] }} {{ tok['s-2'] }} 0; }
        .notice { padding: {{ tok['s-2'] }} {{ tok['s-3'] }}; border-left: 2px solid; font-size: 14px; line-height: 1.5; margin: 0 0 {{ tok['s-12'] }}; }
        .section { margin: 0 0 {{ tok['s-12'] }}; }
        .section-tag { margin: 0 0 {{ tok['s-5'] }}; }
        .rule { display: inline-block; width: 24px; height: 1px; vertical-align: middle; margin-right: {{ tok['s-3'] }}; }
        .lead { padding: {{ tok['s-6'] }}; border: 1px solid; }
        .pill { display: inline-block; padding: 2px 10px; border: 1px solid; border-radius: {{ tok['r-tag'] }}; font-family: {{ tok['font-mono'] }}; font-size: 12px; letter-spacing: .04em; margin: 0 0 {{ tok['s-3'] }}; }
        .lead-title { font-size: 24px; font-weight: 600; line-height: 1.3; letter-spacing: -.015em; margin: 0 0 {{ tok['s-3'] }}; }
        .title { font-size: 18px; font-weight: 600; line-height: 1.3; margin: 0 0 {{ tok['s-2'] }}; }
        .title a, .lead-title a { text-decoration: none; }
        .summary { font-size: 18px; line-height: 1.65; margin: 0 0 {{ tok['s-3'] }}; }
        .desc { font-size: 14px; line-height: 1.5; margin: 0 0 {{ tok['s-3'] }}; }
        .meta { margin: 0; line-height: 1.6; }
        .desc a, .meta a, .footer a { text-decoration: underline; }
        .item { padding: {{ tok['s-5'] }} 0; border-top: 1px solid; }
        .member { margin: {{ tok['s-3'] }} 0 0; }
        .footer { margin: {{ tok['s-12'] }} 0 0; padding: {{ tok['s-5'] }} 0 0; border-top: 1px solid; font-family: {{ tok['font-mono'] }}; font-size: 12px; line-height: 1.8; }
{{ palette(light) }}
        @media (prefers-color-scheme: dark) {
{{ palette(dark) }}
        }
    </style>
</head>
<body class="body">
    <div class="preheader">{% if layers.pebbles %}<span lang="">{{ layers.pebbles[0].item.title }}</span>{% elif layers.sand %}<span lang="{{ content_lang }}">{{ layers.sand[0].heading }}</span>{% endif %} · {{ t("mail.kept_of", included=content.articles_included, received=content.articles_received) }}</div>
    <div class="wrap">
        <p class="brand"><span class="mark"></span>Cyris</p>
        <h1 class="issue-title">{{ issue_name(content.date, content.started_at) }}</h1>
        <p class="stats">{{ t("mail.stats", sources=content.sources_processed, received=content.articles_received, included=content.articles_included, elements={"b": ("b", {})}) }}</p>
        {% if digest_url %}
        <p class="actions"><a class="btn primary" href="{{ digest_url }}">{{ t("email.read_online") }}</a>{% if raw_url %}<a class="btn secondary" href="{{ raw_url }}">{{ t("issue.all_articles") }}</a>{% endif %}</p>
        {% elif publish_failed %}
        <p class="notice">{{ t("mail.publish_failed") }}</p>
        {% endif %}
        {% if degraded %}
        <p class="notice">{{ t("issue.degraded") }}</p>
        {% endif %}
        {% if not content.articles_included %}
        <p class="desc">{% if raw_url %}{{ t("issue.empty_raw", received=content.articles_received, elements={"link": ("a", {"href": raw_url})}) }}{% else %}{{ t("issue.empty", received=content.articles_received) }}{% endif %}</p>
        {% endif %}

        {% if layers.tracking %}
        <section class="section">
            <h2 class="section-tag"><span class="rule"></span>{{ t("layer.tracking") }}</h2>
            {% for topic in layers.tracking %}
            <article class="item" lang="">
                <h3 class="title">{{ topic.heading }}</h3>
                {% for item in topic.items %}
                <h4 class="title member">{{ title_link(item) }}</h4>
                {% endfor %}
            </article>
            {% endfor %}
        </section>
        {% endif %}

        {% if layers.pebbles %}
        <section class="section">
            <h2 class="section-tag"><span class="rule"></span>{{ t("layer.stories") }}</h2>
            {% for pebble in layers.pebbles %}{% set item = pebble.item %}
            <article class="item" lang="{{ '' if pebble.untranslated else content_lang }}">
                <h3 class="title" lang="">{{ title_link(item) }}</h3>
                {% if item.summary %}<p class="summary">{{ item.summary }}</p>{% endif %}
            </article>
            {% endfor %}
        </section>
        {% endif %}

        {% if layers.sand %}
        <section class="section">
            <h2 class="section-tag"><span class="rule"></span>{{ t("layer.topics") }}</h2>
            {% for sand in layers.sand %}
            <article class="item" lang="{{ content_lang }}">
                <h3 class="title">{{ sand.heading }}</h3>
                {% if sand.line %}<p class="summary"{% if sand.line_untranslated %} lang=""{% endif %}>{{ sand.line }}</p>{% endif %}
                <p class="desc" lang="">{% for member in sand.members %}{{ title_link(member) }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
            </article>
            {% endfor %}
        </section>
        {% endif %}

        {% if layers.mail_water %}
        <section class="section">
            <h2 class="section-tag"><span class="rule"></span>{{ t("layer.glance") }}</h2>
            {% for water in layers.mail_water %}{% set item = water.item %}
            <article class="item" lang="{{ '' if water.untranslated else content_lang }}">
                <h3 class="title" lang="">{{ title_link(item) }}</h3>
                {% if item.summary %}<p class="summary">{{ item.summary }}</p>{% endif %}
            </article>
            {% endfor %}
        </section>
        {% endif %}

        {% if digest_url %}
        <p class="actions"><a class="btn primary" href="{{ digest_url }}">{{ t("email.read_online") }}</a></p>
        {% endif %}
        <footer class="footer">
            <div>// {% if content.usage.api_calls and content.usage.estimated_cost is not none %}{{ t("mail.generated_by_cost", tokens=content.usage.total_tokens, calls=content.usage.api_calls, cost="%.4f" | format(content.usage.estimated_cost), elements={"link": ("a", {"href": project_url})}) }}{% else %}{{ t("issue.generated_by", tokens=content.usage.total_tokens, calls=content.usage.api_calls, elements={"link": ("a", {"href": project_url})}) }}{% endif %}</div>
            {% if site %}<div>{{ t("mail.footer_links", elements={"archive": ("a", {"href": site ~ "/"}), "settings": ("a", {"href": site ~ "/settings"})}) }}</div>{% endif %}
        </footer>
    </div>
</body>
</html>
