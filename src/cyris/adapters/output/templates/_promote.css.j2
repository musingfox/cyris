        /* The ↑/↓ glyphs fall back to the generic monospace: Google Fonts serves no
           unicode-range covering U+2191-2193 for Geist Mono. Fine, and the same thing
           the ↗ link marks already do — unlike emoji they still take `color` below. */
        .promote-btn.done { color: var(--accent); border-color: var(--accent); }
        .promote-btn.error { color: var(--warn); border-color: var(--warn); background: var(--warn-tint); }
        .promote-btn.done:hover { color: var(--accent); }
        .promote-btn.error:hover { color: var(--warn); }
        /* The pair splits its gap at the midpoint and each takes the rest of its 44px
           outward, so the boundary does not move with the fallback glyph's width; the
           margin keeps that outward part off whatever comes before the group. */
        .vote-group { display: none; gap: var(--s-1); margin-left: var(--s-2); vertical-align: middle; }
        .vote-group > .promote-btn:first-child::after { left: auto; right: calc(-1px - var(--s-1) / 2); width: 44px; }
        .vote-group > .promote-btn:last-child::after { left: calc(-1px - var(--s-1) / 2); right: auto; width: 44px; }
