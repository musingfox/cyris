        body {
            font-family: var(--font-sans);
            {# `background` is a shorthand and resets background-image, so it has to
               come first: emitted after the longhands, it erases the 32px grid. #}
            background: var(--bg);
            background-image:
                linear-gradient(var(--grid) 1px, transparent 1px),
                linear-gradient(90deg, var(--grid) 1px, transparent 1px);
            background-size: 32px 32px, 32px 32px;
            color: var(--text);
            font-size: calc(14px * var(--type-scale));
            line-height: {{ line_height }};
{%- if font_features %}
            font-feature-settings: "ss01", "ss02", "cv11";
{%- endif %}
            min-height: 100vh;
        }

        .container {
            max-width: {{ container_width }};
            margin: 0 auto;
            {# The gutters live here rather than on body so a bar can span the
               viewport; content-box keeps them outside max-width, where body
               padding used to put them, so no content column changes width. #}
            padding: var(--s-6) var(--s-4) var(--s-20);
            box-sizing: content-box;
{%- if container_relative %}
            position: relative;
{%- endif %}
        }

        a { color: inherit; }
        .settings-link { display: none; }
