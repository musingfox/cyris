        details.more p { margin-top: var(--s-2); }
        .choices { display: grid; border: 1px solid var(--border); border-radius: var(--r-control); overflow: hidden; background: var(--bg-elev); }
        .choice { display: grid; grid-template-columns: auto 1fr auto; gap: var(--s-3); align-items: center; padding: var(--s-3) var(--s-4); border-bottom: 1px solid var(--border); cursor: pointer; transition: background-color var(--t-fast); }
