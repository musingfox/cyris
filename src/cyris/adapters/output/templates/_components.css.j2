        .panel { background: var(--bg-elev); border: 1px solid var(--border); }
        .panel + .panel { margin-top: var(--s-5); }
        .panel-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); padding: var(--s-3) var(--s-5); background: var(--surface); border-bottom: 1px solid var(--border); }
        .list-row { display: grid; align-items: center; gap: var(--s-4); padding: var(--s-3) var(--s-5); border-bottom: 1px solid var(--border); transition: background-color var(--t-fast); }
