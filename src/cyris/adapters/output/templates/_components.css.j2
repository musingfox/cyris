        .site-bar { position: sticky; top: 0; z-index: 10; height: var(--bar-h); background: rgba(7, 7, 10, .88); border-bottom: 1px solid var(--border); }
        .site-bar-inner { height: 100%; max-width: 1240px; margin: 0 auto; padding: 0 var(--s-4); display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); }
