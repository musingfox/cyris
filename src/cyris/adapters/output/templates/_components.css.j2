        .btn { display: inline-flex; align-items: center; gap: var(--s-2); height: 44px; padding: 0 var(--s-5); border: 1px solid transparent; border-radius: var(--r-control); font-family: var(--font-mono); font-size: calc(14px * var(--type-scale)); font-weight: 500; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: color var(--t-fast), background-color var(--t-fast), border-color var(--t-fast), opacity var(--t-fast); }
