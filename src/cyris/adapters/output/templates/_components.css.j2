        .input, .select { width: 100%; height: 48px; padding: 0 var(--s-4); border: 1px solid var(--border-strong); border-radius: var(--r-control); background: var(--bg-elev); color: var(--text); font-size: calc(18px * var(--type-scale)); transition: border-color var(--t-fast); }
