agent-vault/usage.jsonl
# vote-similarity vector caches — regenerable, and large (one per provider: the
# dimensionalities differ, so they cannot share a file)
agent-vault/embeddings.json
agent-vault/embeddings-bge-m3.json
# gemini-vs-bge-m3 parity log + its launchd stdio; go once the provider is settled
agent-vault/embed-parity.jsonl
agent-vault/embed-parity.out
agent-vault/embed-parity.err
# buffer-vs-Miniflux parity log + its launchd stdio; both go once Miniflux is retired
agent-vault/source-parity.jsonl
agent-vault/source-parity.out
agent-vault/source-parity.err

# Docker deployment host output (CYRIS_VAULT_HOST_PATH default)
/vault/

# Claude Code
.claude/settings.local.json
.claude/*.local.md

# Obsidian PM (local obw:pm config — per-developer, not shipped)
.obsidian.yaml
.obsidian-pm.yaml

