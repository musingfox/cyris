# Cyris configuration — copy to cyris.toml. It runs as shipped: the wizard takes a new
# install from here to its first issue, and it asks for everything this file leaves out.
# Secrets (API keys, tokens) come from the environment / .env, never here.
# Runtime settings are not here either. They live in the store, set in the wizard and
# on /settings; a key set in this file stops `cyris doctor`, because nothing reads it.

[agent_vault]
path = "./agent-vault"

[store]
# Where the article store, the runtime settings, the sources and the usage log live.
#   "sqlite" — one SQLite file on this machine, at sqlite_path. No setup: the first
#              server or run creates it.
#   "d1"     — Cloudflare D1. The tables are created on the first boot that reaches
#              the database, so an empty one needs no setup step.
backend = "sqlite"                      # or CYRIS_STORE_BACKEND
# Relative to this file. Never inside the vault; leave it unset under docker compose.
# sqlite_path = "state/cyris.sqlite3"   # or CYRIS_STORE_SQLITE_PATH
database_id = ""                        # or CYRIS_STORE_DATABASE_ID
# account_id via env: CLOUDFLARE_ACCOUNT_ID
# API token via env: CLOUDFLARE_API_TOKEN (needs D1 read+write, same token as Pages)

[html_output]
# The local install's only output: without this (or [promote] publish_enabled)
# a run finishes ok and leaves nothing but store rows.
enabled = true                          # or CYRIS_HTML_OUTPUT_ENABLED
output_dir = "agent-vault/html"
# Where you open the archive, for the Read online link in a notification: scheme, host and
# port only. Empty sends no link. http://127.0.0.1:8766 opens only on the machine running Cyris.
base_url = ""

[promote]
# Optional Cloudflare Worker for promote-button clicks (see workers/promote/).
worker_url = ""                         # or CYRIS_PROMOTE_WORKER_URL
publish_enabled = false                 # or CYRIS_PROMOTE_PUBLISH_ENABLED
pages_project = ""                      # or CYRIS_PROMOTE_PAGES_PROJECT
custom_domain = ""                      # or CYRIS_PROMOTE_CUSTOM_DOMAIN
# Token via env: CYRIS_PROMOTE_TOKEN — deliberately not CYRIS_WORKER_TOKEN.
# It stays server-side: readers vote through the app Worker's POST /api/vote,
# which attaches the token and forwards the vote to the promote Worker.

[newsletter]
# Optional Cloudflare email-ingestion Worker (see workers/newsletter/).
worker_url = ""                         # or CYRIS_NEWSLETTER_WORKER_URL
# Token via env: CYRIS_WORKER_TOKEN

[rss]
# Cloudflare feed-buffer Worker (see workers/rss/): polls feeds hourly into D1 so
# the 24h window sees more than a feed snapshot holds. Leave empty and the
# pipeline polls feeds directly at digest time instead — simpler, but it only
# sees each feed's current snapshot, which for busy feeds is 2-4h, not 24.
worker_url = ""                         # or CYRIS_RSS_WORKER_URL
# Token via env: CYRIS_WORKER_TOKEN
