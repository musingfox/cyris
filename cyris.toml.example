# Cyris configuration — copy to cyris.toml and fill in your values.
# Secrets (API keys, tokens) come from the environment / .env, never here.

[general]
digest_schedule = ["08:00", "20:00"]   # local clock times to run the digest
timezone = "Asia/Taipei"
digest_window_hours = 24

[general.notify]
discord_webhook_url = ""                # optional; falls back to CYRIS_DISCORD_WEBHOOK_URL

[llm_provider]
# "anthropic" (ANTHROPIC_API_KEY), "gemini" (GEMINI_API_KEY), "openai" (OPENAI_API_KEY),
# or "workers_ai"
# (CLOUDFLARE_AI_TOKEN + CLOUDFLARE_ACCOUNT_ID; a token carrying Workers AI -> Read).
# workers_ai keeps everything on one Cloudflare account, but it is not yet a
# drop-in: run `cyris llm-compare` and read both digests before switching.
provider = "anthropic"
model = "claude-sonnet-4-6"             # e.g. "gemini-2.5-flash" when provider = "gemini"

[digest]
max_articles_per_digest = 400           # cap fed into the pipeline; set above daily volume or it truncates
max_articles_per_digest_output = 15     # cap shown in the digest note
output_language = "繁體中文"             # language for digest headlines/summaries (e.g. "English")
style_prompt = ""                       # optional: your tone/focus, injected into the prompts

[agent_vault]
path = "./agent-vault"

[store]
# Where the article store and the usage log live.
#   "json" — partition files under [agent_vault] path. No setup, but a dead
#            machine takes the store with it.
#   "d1"   — Cloudflare D1. Create the tables with
#            `wrangler d1 execute <db> --remote --file=src/cyris/adapters/store/schema.sql`,
#            copy the local store over with `cyris store migrate`, and compare the
#            two with `cyris store diff` before switching.
backend = "json"                        # or CYRIS_STORE_BACKEND
database_id = ""                        # or CYRIS_STORE_DATABASE_ID
# account_id via env: CLOUDFLARE_ACCOUNT_ID
# API token via env: CLOUDFLARE_API_TOKEN (needs D1 read+write, same token as Pages)

[routing]
score_threshold = 70                    # featured-article cutoff (0-100)
summarize_score_threshold = 70

[html_output]
enabled = false                         # or CYRIS_HTML_OUTPUT_ENABLED
output_dir = "agent-vault/html"

[promote]
# Optional Cloudflare Worker for promote-button clicks (see workers/promote/).
worker_url = ""
publish_enabled = false                 # or CYRIS_PROMOTE_PUBLISH_ENABLED
pages_project = ""                      # or CYRIS_PROMOTE_PAGES_PROJECT
custom_domain = ""                      # or CYRIS_PROMOTE_CUSTOM_DOMAIN
# Token via env: CYRIS_PROMOTE_TOKEN — deliberately not CYRIS_WORKER_TOKEN.
# Since private-votes-public-archive, the token is server-side only (never rendered
# into HTML). Votes go through POST /api/vote on the Worker (Access-only), which
# attaches the token server-side and forwards to the promote Worker.

[newsletter]
# Optional Cloudflare email-ingestion Worker (see workers/newsletter/).
worker_url = ""
# Token via env: CYRIS_WORKER_TOKEN

[vote_similarity]
# Suppress candidates that sit close to a downvoted article. Runs over every
# candidate, not just scored ones — the scorer skips news, and the class that
# drew the first downvote was news-tagged. Preview with `cyris vote-sim` before
# enabling, and compare providers with `cyris embed-compare`.
enabled = false
# provider = "workers_ai"   # @cf/baai/bge-m3 via CLOUDFLARE_EMBEDDING_API_TOKEN
#                           # + CLOUDFLARE_ACCOUNT_ID. "gemini" uses GEMINI_API_KEY.
# Leave `threshold` unset: each provider carries its own calibration (bge-m3 0.53,
# gemini 0.68) because their cosines run on different scales. Setting one value and
# switching provider is how this feature silently stops suppressing anything.
# threshold = 0.53
# model = "@cf/baai/bge-m3"
# max_seeds = 200

[rss]
# Cloudflare feed-buffer Worker (see workers/rss/): polls feeds hourly into D1 so
# the 24h window sees more than a feed snapshot holds. Leave empty and the
# pipeline polls feeds directly at digest time instead — simpler, but it only
# sees each feed's current snapshot, which for busy feeds is 2-4h, not 24.
worker_url = ""
# Token via env: CYRIS_WORKER_TOKEN
