# LLM provider key — set the one matching cyris.toml [llm_provider]
# Anthropic Claude (provider = "anthropic")
ANTHROPIC_API_KEY=

# Google Gemini (provider = "gemini")
GEMINI_API_KEY=

# Cloudflare Email Routing webhook (Phase 2)
CYRIS_EMAIL_WEBHOOK_SECRET=
# Cloudflare Workers — optional (promote / email-newsletter). Blank = disabled.
CYRIS_PROMOTE_TOKEN=
CYRIS_NEWSLETTER_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMBEDDING_API_TOKEN=

# Cloudflare RSS Worker buffer — blank falls back to polling feeds directly
# at digest time (see cyris.toml.example [rss]).
CYRIS_RSS_TOKEN=

# Publishing the HTML digest to Pages shells out to wrangler, which reads this.
# Needed only when [promote] publish_enabled = true.
CLOUDFLARE_API_TOKEN=

# Discord digest notifications — overrides [general.notify] in cyris.toml,
# so the webhook can stay out of the config file.
CYRIS_DISCORD_WEBHOOK_URL=
