# Miniflux
CYRIS_MINIFLUX_API_KEY=

# LLM provider key — set the one matching cyris.toml [llm_provider]
# Anthropic Claude (provider = "anthropic")
ANTHROPIC_API_KEY=

# Google Gemini (provider = "gemini")
GEMINI_API_KEY=

# Cloudflare Email Routing webhook (Phase 2)
CYRIS_EMAIL_WEBHOOK_SECRET=
# Cloudflare Workers — optional (promote / email-newsletter). Blank = disabled.
CYRIS_PROMOTE_TOKEN=
CYRIS_NEWSLETTER_TOKEN=

# docker-compose Miniflux/Postgres creds — override dev defaults before exposing the port.
MINIFLUX_ADMIN_PASSWORD=cyris2026
POSTGRES_PASSWORD=secret
