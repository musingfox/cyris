# Two audiences read this file. A local `cyris` run loads it as .env: there the
# LLM key is all a first run needs, and the Cloudflare names matter only once a
# local install uses D1, Pages, Workers AI or one of the Workers. A Deploy to
# Cloudflare button reads it to decide which Worker secrets to ask for; per-key
# guidance lives in package.json's `cloudflare.bindings`, which is what the
# deploy page renders. The app Worker (workers/app/src/index.js) forwards every
# name below into the container except CYRIS_UI_TOKEN, DIGEST_ORIGIN and
# CYRIS_UI_ACCESS_HOST, which only the Worker reads. Keep the three in step.

# --- LLM (local and Cloudflare) ---

# The key for the provider you choose, or none with provider "none" (plain
# excerpts). The *provider* is not an env var: choose it on /settings (written to
# D1) or in [llm_provider] in cyris.toml for a local run. Until a provider is
# chosen every run stops and names the missing setting, and a provider whose key
# is blank stops the run too.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Required on Cloudflare ---

# The only lock on the triage UI and the vote API: openssl rand -hex 32
CYRIS_UI_TOKEN=

# The Pages origin the Worker proxies the public archive from, and the project
# it deploys the digest to. Deploy buttons do not provision Pages, but you do not
# have to create it either: the first publish creates the project from the name
# below. DIGEST_ORIGIN is the override — set it only when the archive is not at
# <project>.pages.dev, such as a custom domain. With neither, the archive is 503.
DIGEST_ORIGIN=
CYRIS_PROMOTE_PAGES_PROJECT=

# The account, and a token with D1:Edit + Cloudflare Pages:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The D1 database UUID. The container talks to D1 over REST rather than through
# a Worker binding, so this is an id you paste once, not a binding the deploy
# provisions. `cyris` creates the tables on first boot.
CYRIS_STORE_DATABASE_ID=

# --- Optional ---

# Cloudflare Access, and only after you have verified it blocks. Setting this
# before Access exists makes the vote API answer 401 to logged-in readers.
CYRIS_UI_ACCESS_HOST=

# The one bearer the rss and newsletter Workers accept. Server-to-server: it
# never leaves the container.
CYRIS_WORKER_TOKEN=

# The vote Worker's bearer (workers/promote/), set to the same value as its
# PROMOTE_TOKEN. It stays server-side: readers vote through the app Worker's
# POST /api/vote, which attaches it. Keep it a separate value from the one above.
CYRIS_PROMOTE_TOKEN=

# The other three Workers. Blank disables each: no rss buffer means feeds are
# polled at digest time, no newsletter Worker means email-only sources are off,
# no promote Worker means a vote is refused (503) instead of recorded.
CYRIS_RSS_WORKER_URL=
CYRIS_NEWSLETTER_WORKER_URL=
CYRIS_PROMOTE_WORKER_URL=

# The hostname readers use, if you attached one. On a domainless deploy, this
# Worker's own *.workers.dev hostname.
CYRIS_PROMOTE_CUSTOM_DOMAIN=

# A Workers AI:Read token for @cf/baai/bge-m3 vote-similarity filtering. NOT the
# same token as CLOUDFLARE_API_TOKEN.
CLOUDFLARE_EMBEDDING_API_TOKEN=

# A Workers AI:Read token for the workers_ai LLM provider. Blank falls back to
# CLOUDFLARE_EMBEDDING_API_TOKEN, which the same permission already covers.
CLOUDFLARE_AI_TOKEN=

# Left to the container's defaults (docker/entrypoint.sh) unless you are
# deliberately overriding them: CYRIS_STORE_BACKEND, CYRIS_HTML_OUTPUT_ENABLED,
# CYRIS_PROMOTE_PUBLISH_ENABLED.
