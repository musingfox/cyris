# LLM provider key — set the one matching cyris.toml [llm_provider]
# Anthropic Claude (provider = "anthropic")
ANTHROPIC_API_KEY=

# Google Gemini (provider = "gemini")
GEMINI_API_KEY=

# Cloudflare Email Routing webhook (Phase 2)
# Cloudflare Workers — optional (rss buffer / email-newsletter). Blank = disabled.
# Server-to-server: never leaves the container.
CYRIS_WORKER_TOKEN=

# The vote Worker (workers/promote/). Kept apart from the one above because it
# is NOT a secret: the digest's up/down buttons run in the reader's browser, so
# this value is rendered into every published page.
CYRIS_PROMOTE_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMBEDDING_API_TOKEN=

# Cloudflare RSS Worker buffer — blank falls back to polling feeds directly
# at digest time (see cyris.toml.example [rss]).

# Publishing the HTML digest to Pages shells out to wrangler, which reads this.
# Needed only when [promote] publish_enabled = true.
CLOUDFLARE_API_TOKEN=

# Deployment identity (grade B, optional). Empty file values yield to these.
CYRIS_HTML_OUTPUT_ENABLED=
CYRIS_PROMOTE_PUBLISH_ENABLED=
CYRIS_PROMOTE_PAGES_PROJECT=
CYRIS_PROMOTE_CUSTOM_DOMAIN=

# Discord digest notifications — overrides [general.notify] in cyris.toml,
# so the webhook can stay out of the config file.
CYRIS_DISCORD_WEBHOOK_URL=
