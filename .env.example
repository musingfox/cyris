# Two audiences read this file: a local `cyris` run loads it as .env, and a
# Deploy to Cloudflare button reads it to decide which Worker secrets to ask
# for. Every name below is forwarded to the container by workers/app/src/index.js
# — keep the two in step. Per-key guidance lives in package.json's
# `cloudflare.bindings`, which is what the deploy page renders.

# --- Required ---

# One LLM key. The *provider* is chosen separately and is not an env var: set it
# on /settings (written to D1) or in [llm_provider] in cyris.toml for a local run.
# A key with no provider chosen leaves the digest in plain-excerpt mode.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# The only lock on the triage UI and the vote API: openssl rand -hex 32
CYRIS_UI_TOKEN=

# The Pages origin the Worker proxies the public archive from, and the project
# it deploys the digest to. Create the Pages project yourself — Deploy buttons
# do not provision Pages. Unset, the archive path answers 503.
DIGEST_ORIGIN=
CYRIS_PROMOTE_PAGES_PROJECT=

# The account, and a token with D1:Edit + Cloudflare Pages:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The D1 database UUID. The container talks to D1 over REST rather than through
# a Worker binding, so this is an id you paste once, not a binding the deploy
# provisions. `cyris` creates the tables on first boot.
CYRIS_STORE_DATABASE_ID=

# --- Optional ---

# Cloudflare Access, and only after you have verified it blocks. Setting this
# before Access exists makes the vote API answer 401 to logged-in readers.
CYRIS_UI_ACCESS_HOST=

# The one bearer the rss and newsletter Workers accept. Server-to-server: it
# never leaves the container.
CYRIS_WORKER_TOKEN=

# The vote Worker (workers/promote/). Kept apart from the one above because it
# is NOT a secret: it is baked into every digest published before 2026-09-01, so
# rotating it would break the vote buttons across the archive. Since then it stays
# server-side — votes go through the app Worker's POST /api/vote, which attaches it.
CYRIS_PROMOTE_TOKEN=

# The other three Workers. Blank disables each: no rss buffer means feeds are
# polled at digest time, no newsletter Worker means email-only sources are off,
# no promote Worker means no vote buttons.
CYRIS_RSS_WORKER_URL=
CYRIS_NEWSLETTER_WORKER_URL=
CYRIS_PROMOTE_WORKER_URL=

# The hostname readers use, if you attached one. On a domainless deploy, this
# Worker's own *.workers.dev hostname.
CYRIS_PROMOTE_CUSTOM_DOMAIN=

# A Workers AI:Read token for @cf/baai/bge-m3 vote-similarity filtering. NOT the
# same token as CLOUDFLARE_API_TOKEN.
CLOUDFLARE_EMBEDDING_API_TOKEN=

# Discord digest notifications — overrides [general.notify] in cyris.toml, so
# the webhook can stay out of the config file.
CYRIS_DISCORD_WEBHOOK_URL=

# Left to the container's defaults (docker/entrypoint.sh) unless you are
# deliberately overriding them: CYRIS_STORE_BACKEND, CYRIS_HTML_OUTPUT_ENABLED,
# CYRIS_PROMOTE_PUBLISH_ENABLED.
