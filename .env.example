# Two audiences read this file. A local `cyris` run loads it as .env: there the
# LLM key is all a first run needs, and the Cloudflare names matter only once a
# local install uses D1, Pages, Workers AI or one of the Workers. A Deploy to
# Cloudflare button reads it to decide which Worker secrets to ask for; per-key
# guidance lives in package.json's `cloudflare.bindings`, which is what the
# deploy page renders. The app Worker (workers/app/src/index.js) forwards every
# name below into the container except CYRIS_ACCESS_TEAM_DOMAIN, CYRIS_ACCESS_AUD,
# DIGEST_ORIGIN and CYRIS_PRIVATE_ARCHIVE, which only the Worker reads.
# Keep this file, package.json's bindings and the Worker's reads in step.

# --- LLM (local and Cloudflare) ---

# The key for the provider you choose, or none with provider "none" (plain
# excerpts). The *provider* is not an env var: choose it on /settings (written to
# D1) or in [llm_provider] in cyris.toml for a local run. Until a provider is
# chosen every run stops and names the missing setting, and a provider whose key
# is blank stops the run too.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# The openai_compatible LLM: its endpoint, its model and its key all live here.
# The key is optional — a LAN or localhost endpoint may answer with none — and
# /settings stores only the provider choice.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# The openai_compatible embedder: the same three, its own names and account.
OPENAI_COMPATIBLE_EMBEDDING_API_KEY=
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=

# --- Required on Cloudflare ---

# Cloudflare Access, the only sign-in: the team domain as a host without a scheme,
# and the Application Audience (AUD) tag of the Access application.
CYRIS_ACCESS_TEAM_DOMAIN=
CYRIS_ACCESS_AUD=

# The Pages origin the Worker proxies the public archive from, and the project
# it deploys the digest to. Deploy buttons do not provision Pages, but you do not
# have to create it either: the first publish creates the project from the name
# below. DIGEST_ORIGIN is the override — set it only when the archive is not at
# <project>.pages.dev, such as a custom domain. With neither, the archive is 503.
DIGEST_ORIGIN=
CYRIS_PROMOTE_PAGES_PROJECT=

# The account, and a token with D1:Edit + Cloudflare Pages:Edit, plus Workers
# Scripts:Read so the digest link can find this Worker's custom domain, and Email
# Sending:Edit if /settings sets an email address.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The D1 database UUID. The container talks to D1 over REST rather than through
# a Worker binding, so this is an id you paste once, not a binding the deploy
# provisions. `cyris` creates the tables on first boot.
CYRIS_STORE_DATABASE_ID=

# Where cyris keeps its SQLite store when CYRIS_STORE_BACKEND=sqlite: the
# local/container track's counterpart of the D1 id above. Cloudflare track:
# leave empty.
CYRIS_STORE_SQLITE_PATH=

# --- Optional ---

# "true" puts the archive behind the same Cloudflare Access sign-in as /settings;
# a reader without one gets a 403. Unset, the archive is public. Worker-only.
CYRIS_PRIVATE_ARCHIVE=

# The Cloudflare Access service token that scripts sign in with (cyris doctor
# --deployment, the deploy verify step). The Worker never reads them, and the
# deploy form does not ask for them.
# CYRIS_ACCESS_CLIENT_ID=
# CYRIS_ACCESS_CLIENT_SECRET=

# The one bearer the rss and newsletter Workers accept. Server-to-server: it
# never leaves the container.
CYRIS_WORKER_TOKEN=

# The vote Worker's bearer (workers/promote/), set to the same value as its
# PROMOTE_TOKEN. It stays server-side: readers vote through the app Worker's
# POST /api/vote, which attaches it. Keep it a separate value from the one above.
CYRIS_PROMOTE_TOKEN=

# The other three Workers. Blank disables each: no rss buffer means feeds are
# polled at digest time, no newsletter Worker means email-only sources are off,
# no promote Worker means a vote is refused (503) instead of recorded.
CYRIS_RSS_WORKER_URL=

# "true" makes the hourly tick fill the local feed buffer (cyris buffer) instead
# of relying on the RSS Worker above; sqlite store only. Cloudflare track:
# leave empty.
CYRIS_RSS_LOCAL_BUFFER=
CYRIS_NEWSLETTER_WORKER_URL=
CYRIS_PROMOTE_WORKER_URL=

# Overrides the digest link's host. Unset, a run uses the custom domain attached
# to this Worker, which needs Workers Scripts:Read on CLOUDFLARE_API_TOKEN. On a
# domainless deploy, set it to this Worker's own *.workers.dev hostname.
CYRIS_PROMOTE_CUSTOM_DOMAIN=

# With no Pages project to publish to: the origin a local digest links
# notifications to, e.g. http://<host>:8767 (cyris serve). Cloudflare track:
# leave empty.
CYRIS_PROMOTE_LOCAL_ORIGIN=

# A Workers AI:Read token for @cf/baai/bge-m3 vote-similarity filtering. NOT the
# same token as CLOUDFLARE_API_TOKEN.
CLOUDFLARE_EMBEDDING_API_TOKEN=

# A Workers AI:Read token for the workers_ai LLM provider and the
# Clef vote order (digest.preference_source = "clef"). Blank
# falls back to CLOUDFLARE_EMBEDDING_API_TOKEN, which the same permission already
# covers.
CLOUDFLARE_AI_TOKEN=

# An Account > AI Gateway > Run token for the ai_gateway LLM provider. No fallback:
# the Workers AI tokens above are refused by the gateway. The provider's own key lives
# in the gateway, so the three LLM keys above can stay blank.
CLOUDFLARE_AIG_TOKEN=

# Left to the container's defaults (docker/entrypoint.sh) unless you are
# deliberately overriding them: CYRIS_STORE_BACKEND, CYRIS_HTML_OUTPUT_ENABLED,
# CYRIS_PROMOTE_PUBLISH_ENABLED.
